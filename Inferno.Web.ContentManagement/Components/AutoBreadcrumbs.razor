@using Inferno.Web.ContentManagement.Components
@using Inferno.Web.Navigation
@using Microsoft.AspNetCore.Components.Authorization

@if (breadcrumbs.Count > 0)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">@T[InfernoWebLocalizableStrings.General.Home]</a></li>
            @foreach (var crumb in breadcrumbs)
            {
                if (string.IsNullOrEmpty(crumb.Url))
                {
                    <li class="breadcrumb-item active" aria-current="page">@crumb.Text</li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="@crumb.Url">@crumb.Text</a></li>
                }
            }
        </ol>
    </nav>
}

@code {
    [Inject]
    private CmsBreadcrumbBuilder BreadcrumbBuilder { get; set; }

    [Inject]
    private Microsoft.AspNetCore.Components.NavigationManager NavigationManager { get; set; }

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; }

    private List<Breadcrumb> breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        string path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        breadcrumbs = (await BreadcrumbBuilder.BuildAsync(path, state.User)).ToList();
    }
}

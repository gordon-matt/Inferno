@using Inferno.Security.Membership
@using Inferno.Web.ContentManagement.Areas.Admin.Blog
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Entities
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Services
@using Inferno.Web.ContentManagement.Areas.Admin.Pages
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore

@if (!allowed)
{
    <div class="alert alert-warning" role="alert">You do not have access to the blog.</div>
}
else
{
    <PageTitle>@BlogSettings.PageTitle</PageTitle>
    <h1>@Heading</h1>

    @if (posts.Count == 0)
    {
        <p>No posts yet.</p>
    }
    else
    {
        @foreach (var post in posts)
        {
            <BlogPostSummary Post="post" Author="@Author(post)" PostedOn="@FormatDate(post.DateCreatedUtc)" Tags="tags" />
        }
    }

    @if (pageCount > 1)
    {
        <nav aria-label="Blog pages">
            <ul class="pagination">
                @for (int i = 1; i <= pageCount; i++)
                {
                    int pageNumber = i;
                    <li class="page-item @(pageNumber == pageIndex ? "active" : null)">
                        <a class="page-link" href="@($"{PagingPath}?pageIndex={pageNumber}")">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@code {
    [Parameter]
    public string Heading { get; set; }

    [Parameter]
    public string PagingPath { get; set; } = "/blog";

    [Parameter]
    public int? CategoryId { get; set; }

    [Parameter]
    public int? TagId { get; set; }

    [Inject]
    private BlogSettings BlogSettings { get; set; }

    [Inject]
    private IBlogPostService PostService { get; set; }

    [Inject]
    private IBlogTagService TagService { get; set; }

    [Inject]
    private IMembershipService MembershipService { get; set; }

    [Inject]
    private IWorkContext WorkContext { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; }

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; }

    private bool allowed = true;
    private int pageIndex = 1;
    private int pageCount = 1;
    private List<BlogPost> posts = [];
    private Dictionary<int, BlogTag> tags = [];
    private Dictionary<string, string> authors = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        WorkContext.SetState<Guid?>("CurrentPageId", null);
        WorkContext.Breadcrumbs.Clear();
    }

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        allowed = await PageSecurityHelper.CheckUserHasAccessToBlog(state.User);
        if (!allowed)
        {
            return;
        }

        var query = QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query);
        pageIndex = query.TryGetValue("pageIndex", out var pageValues) && int.TryParse(pageValues.ToString(), out int parsed) && parsed > 0
            ? parsed
            : 1;
        int pageSize = BlogSettings.ItemsPerPage <= 0 ? 5 : BlogSettings.ItemsPerPage;
        int tenantId = WorkContext.CurrentTenant.Id;

        using (var connection = TagService.OpenConnection())
        {
            tags = connection.Query(x => x.TenantId == tenantId).ToDictionary(x => x.Id);
        }

        using (var connection = PostService.OpenConnection())
        {
            IQueryable<BlogPost> filtered = connection.Query(x => x.TenantId == tenantId)
                .Include(x => x.Category)
                .Include(x => x.Tags);

            if (CategoryId.HasValue)
            {
                int categoryId = CategoryId.Value;
                filtered = filtered.Where(x => x.CategoryId == categoryId);
            }

            if (TagId.HasValue)
            {
                int tagId = TagId.Value;
                filtered = filtered.Where(x => x.Tags.Any(y => y.TagId == tagId));
            }

            int total = await filtered.CountAsync();
            pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
            posts = await filtered
                .OrderByDescending(x => x.DateCreatedUtc)
                .Skip((pageIndex - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();
        }

        var userIds = posts.Select(x => x.UserId).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();
        authors = new Dictionary<string, string>(StringComparer.Ordinal);
        if (userIds.Count > 0)
        {
            var users = await MembershipService.GetUsersAsync(tenantId, x => userIds.Contains(x.Id));
            foreach (var user in users)
            {
                authors[user.Id] = user.UserName;
            }
        }

        if (!string.IsNullOrEmpty(Heading) && !string.Equals(Heading, BlogSettings.PageTitle, StringComparison.Ordinal))
        {
            WorkContext.Breadcrumbs.Add(Heading);
        }
    }

    private string Author(BlogPost post) =>
        post.UserId != null && authors.TryGetValue(post.UserId, out string name) ? name : "Unknown";

    private string FormatDate(DateTime value)
    {
        string format = BlogSettings.DateFormat;
        if (string.IsNullOrWhiteSpace(format) || format.Contains("YYYY", StringComparison.Ordinal))
        {
            format = "yyyy-MM-dd HH:mm";
        }

        return value.ToString(format);
    }
}

@page "/blog/tag/{TagSlug}"
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Entities
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Services

@if (tag == null)
{
    <div class="alert alert-secondary" role="alert">That tag could not be found.</div>
}
else
{
    <BlogPostList Heading="@tag.Name" PagingPath="@($"/blog/tag/{tag.UrlSlug}")" TagId="tag.Id" />
}

@code {
    [Parameter]
    public string TagSlug { get; set; }

    [Inject]
    private IBlogTagService TagService { get; set; }

    [Inject]
    private IWorkContext WorkContext { get; set; }

    private BlogTag tag;

    protected override void OnParametersSet()
    {
        int tenantId = WorkContext.CurrentTenant.Id;
        tag = TagService.FindOne(new Extenso.Data.Entity.SearchOptions<BlogTag>
        {
            Query = x => x.TenantId == tenantId && x.UrlSlug == TagSlug
        });
    }
}

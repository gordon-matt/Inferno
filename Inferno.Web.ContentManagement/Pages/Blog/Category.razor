@page "/blog/category/{CategorySlug}"
@using Inferno.Web.ContentManagement.Areas.Admin.Blog
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Entities
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Services

@if (category == null)
{
    <div class="alert alert-secondary" role="alert">That category could not be found.</div>
}
else
{
    <BlogPostList Heading="@category.Name" PagingPath="@($"/blog/category/{category.UrlSlug}")" CategoryId="category.Id" />
}

@code {
    [Parameter]
    public string CategorySlug { get; set; }

    [Inject]
    private IBlogCategoryService CategoryService { get; set; }

    [Inject]
    private IWorkContext WorkContext { get; set; }

    private BlogCategory category;

    protected override void OnParametersSet()
    {
        int tenantId = WorkContext.CurrentTenant.Id;
        category = CategoryService.FindOne(new Extenso.Data.Entity.SearchOptions<BlogCategory>
        {
            Query = x => x.TenantId == tenantId && x.UrlSlug == CategorySlug
        });
    }
}

@page "/admin/menus/index"
@attribute [Authorize(Policy = CmsConstants.Policies.MenusRead)]
@inherits AdminPage

<PageTitle>@T[InfernoCmsLocalizableStrings.Menus.Title]</PageTitle>

<PageHeader Title="@T[InfernoCmsLocalizableStrings.Menus.Title]" Icon="menu" Description="@T[InfernoCmsLocalizableStrings.Menus.Description]">
    <Actions>
        @if (canWrite)
        {
            <button type="button" class="nf-button nf-button-primary" @onclick="Create">
                <Icon Name="plus" Size="16" /> @T[InfernoCmsLocalizableStrings.Menus.NewMenu]
            </button>
        }
    </Actions>
</PageHeader>

<div class="nf-toolbar">
    <SearchField Value="@search" ValueChanged="SearchChangedAsync" Placeholder="@T[InfernoWebLocalizableStrings.Admin.SearchPlaceholder]" />
</div>

@if (menus is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (menus.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(search))
    {
        <EmptyState Icon="menu" Title="@T[InfernoCmsLocalizableStrings.Menus.EmptyTitle]">
            @if (canWrite)
            {
                <button type="button" class="nf-button nf-button-primary" @onclick="Create">
                    <Icon Name="plus" Size="16" /> @T[InfernoCmsLocalizableStrings.Menus.NewMenu]
                </button>
            }
        </EmptyState>
    }
    else
    {
        <EmptyState Icon="search" Title="@T[InfernoWebLocalizableStrings.Admin.NoMatchesTitle]" Description="@T[InfernoWebLocalizableStrings.Admin.NoMatchesDescription]" />
    }
}
else
{
    <Table>
        <thead>
            <tr>
                <th>@T[InfernoCmsLocalizableStrings.Menus.MenuModel.Name]</th>
                <th>@T[InfernoCmsLocalizableStrings.Menus.MenuModel.UrlFilter]</th>
                <th class="nf-cell-number">@T[InfernoCmsLocalizableStrings.Menus.Items]</th>
                <th class="nf-cell-actions"><span class="nf-sr-only">@T[InfernoWebLocalizableStrings.General.Actions]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menu in menus)
            {
                <tr @key="menu.Id">
                    <td><a class="nf-row-title" href="@ItemsUrl(menu.Id)">@menu.Name</a></td>
                    <td class="nf-muted">@(string.IsNullOrEmpty(menu.UrlFilter) ? "—" : menu.UrlFilter)</td>
                    <td class="nf-cell-number">@menu.ItemCount</td>
                    <td class="nf-cell-actions">
                        <div class="nf-row-actions">
                            <a class="nf-icon-button" href="@ItemsUrl(menu.Id)" title="@T[InfernoCmsLocalizableStrings.Menus.ManageMenuItems]">
                                <Icon Name="list" Size="16" />
                            </a>
                            @if (canWrite)
                            {
                                <button type="button" class="nf-icon-button" title="@T[InfernoWebLocalizableStrings.General.Edit]" @onclick="() => Edit(menu)">
                                    <Icon Name="edit" Size="16" />
                                </button>
                                <button type="button" class="nf-icon-button nf-danger-hover" title="@T[InfernoWebLocalizableStrings.General.Delete]" @onclick="() => DeleteAsync(menu)">
                                    <Icon Name="trash" Size="16" />
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </Table>
}

<Drawer Open="editing is not null" Scrim="true" Width="min(440px, 100vw)" OnClose="Close"
        Title="@(editing?.Id == Guid.Empty ? T[InfernoCmsLocalizableStrings.Menus.NewMenu].Value : T[InfernoWebLocalizableStrings.General.EditFormat, editing?.Name ?? string.Empty].Value)">
    <ChildContent>
        @if (editing is not null)
        {
            <EditForm id="menu-form" Model="editing" OnValidSubmit="SaveAsync">
                <Field Label="@T[InfernoCmsLocalizableStrings.Menus.MenuModel.Name]" For="menu-name">
                    <InputText id="menu-name" class="nf-input" @bind-Value="editing.Name" autofocus />
                    <ErrorText Errors="errors" Key="Name" />
                </Field>
                <Field Label="@T[InfernoCmsLocalizableStrings.Menus.MenuModel.UrlFilter]" For="menu-url-filter">
                    <InputText id="menu-url-filter" class="nf-input" @bind-Value="editing.UrlFilter" />
                    <span class="nf-hint">@T[InfernoCmsLocalizableStrings.Menus.UrlFilterHint]</span>
                </Field>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="Close">@T[InfernoWebLocalizableStrings.General.Cancel]</button>
        <button type="submit" form="menu-form" class="nf-button nf-button-primary" disabled="@saving">
            <Icon Name="save" Size="16" /> @T[InfernoWebLocalizableStrings.General.Save]
        </button>
    </Footer>
</Drawer>

@page "/admin/menus/items/{MenuId:guid}"
@using Inferno.Web.ContentManagement.Areas.Admin.Menus.Entities
@inherits RadzenDataPage<MenuItem, Guid>

<h1>@T[InfernoCmsLocalizableStrings.Menus.ManageMenuItems] — @MenuName</h1>

<div class="row" hidden="@(ShowEditMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="GoBack">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Back]
        </RadzenButton>
    </div>

    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="MenuItem"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="10"
                        ColumnWidth="200px">
            <Columns>
                <RadzenDataGridColumn TItem="MenuItem" Property="Text" Title="@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Text]" />
                <RadzenDataGridColumn TItem="MenuItem" Property="Url" Title="@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Url]" />
                <RadzenDataGridColumn TItem="MenuItem" Property="Position" Title="@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Position]" Width="100px" />
                <RadzenDataGridColumn TItem="MenuItem" Property="Enabled" Title="@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Enabled]" Width="100px" />
                <RadzenDataGridColumn TItem="MenuItem" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="120px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(() => EditAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(() => DeleteAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="form-section" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">@T[InfernoWebLocalizableStrings.General.Details]</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Text]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.Text" Style="width:100%" Name="Text" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Url]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.Url" Style="width:100%" Name="Url" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-2">@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Description]</label>
                                <div class="col-md-10">
                                    <RadzenTextBox @bind-Value="Model.Description" Style="width:100%" Name="Description" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.CssClass]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.CssClass" Style="width:100%" Name="CssClass" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Position]</label>
                                <div class="col-md-8">
                                    <RadzenNumeric @bind-Value="Model.Position" Style="width:100%" Name="Position" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.Enabled" />@T[InfernoCmsLocalizableStrings.Menus.MenuItemModel.Enabled]</label></div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.IsExternalUrl" />@T[InfernoCmsLocalizableStrings.Menus.IsExternalUrl]</label></div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

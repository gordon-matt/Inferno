@page "/admin/blocks/entity-type-content-blocks"
@attribute [Authorize(Policy = CmsConstants.Policies.ContentBlocksRead)]
@inherits AdminPage

<PageTitle>@T[InfernoCmsLocalizableStrings.ContentBlocks.EntityTypeContentBlocks]</PageTitle>

<nav class="nf-breadcrumbs" aria-label="Breadcrumb">
    <a href="/admin/blocks/content-blocks">@T[InfernoCmsLocalizableStrings.ContentBlocks.Title]</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">@T[InfernoCmsLocalizableStrings.ContentBlocks.EntityTypeContentBlocks]</span>
</nav>

<PageHeader Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.EntityTypeContentBlocks]" Icon="grid" Description="@T[InfernoCmsLocalizableStrings.ContentBlocks.EntityTypeDescription]">
    <Actions>
        @if (canWrite)
        {
            <button type="button" class="nf-button nf-button-primary" @onclick="Create">
                <Icon Name="plus" Size="16" /> @T[InfernoCmsLocalizableStrings.ContentBlocks.NewBlock]
            </button>
        }
    </Actions>
</PageHeader>

<div class="nf-toolbar">
    <SearchField Value="@search" ValueChanged="SearchChangedAsync" Placeholder="@T[InfernoWebLocalizableStrings.Admin.SearchPlaceholder]" />
    <select class="nf-select" aria-label="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.ZoneId]" value="@(zoneFilter?.ToString() ?? string.Empty)" @onchange="ZoneFilterChangedAsync">
        <option value="">@T[InfernoCmsLocalizableStrings.ContentBlocks.AllZones]</option>
        @foreach (var zone in zones)
        {
            <option value="@zone.Id">@zone.Name</option>
        }
    </select>
</div>

@if (blocks is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (blocks.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(search) && zoneFilter is null)
    {
        <EmptyState Icon="grid" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.EmptyTitle]" Description="@T[InfernoCmsLocalizableStrings.ContentBlocks.EntityTypeDescription]">
            @if (canWrite)
            {
                <button type="button" class="nf-button nf-button-primary" @onclick="Create">
                    <Icon Name="plus" Size="16" /> @T[InfernoCmsLocalizableStrings.ContentBlocks.NewBlock]
                </button>
            }
        </EmptyState>
    }
    else
    {
        <EmptyState Icon="search" Title="@T[InfernoWebLocalizableStrings.Admin.NoMatchesTitle]" Description="@T[InfernoWebLocalizableStrings.Admin.NoMatchesDescription]" />
    }
}
else
{
    <Table>
        <thead>
            <tr>
                <th>@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Title]</th>
                <th>@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.EntityType]</th>
                <th>@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.EntityId]</th>
                <th>@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.BlockType]</th>
                <th>@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.ZoneId]</th>
                <th>@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.IsEnabled]</th>
                <th class="nf-cell-actions"><span class="nf-sr-only">@T[InfernoWebLocalizableStrings.General.Actions]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var block in blocks)
            {
                <tr @key="block.Id">
                    <td>
                        @if (canWrite)
                        {
                            <button type="button" class="nf-link-button nf-row-title" @onclick="() => Edit(block)">@block.Title</button>
                        }
                        else
                        {
                            <span class="nf-row-title">@block.Title</span>
                        }
                    </td>
                    <td class="nf-muted inferno-code nf-truncate" title="@block.EntityType">@ShortTypeName(block.EntityType)</td>
                    <td class="nf-muted inferno-code">@block.EntityId</td>
                    <td class="nf-muted">@block.BlockName</td>
                    <td><span class="nf-badge nf-badge-muted">@ZoneName(block.ZoneId)</span></td>
                    <td>
                        @if (block.IsEnabled)
                        {
                            <span class="nf-badge nf-badge-success">@T[InfernoWebLocalizableStrings.Admin.On]</span>
                        }
                        else
                        {
                            <span class="nf-badge nf-badge-muted">@T[InfernoWebLocalizableStrings.Admin.Off]</span>
                        }
                    </td>
                    <td class="nf-cell-actions">
                        @if (canWrite)
                        {
                            <div class="nf-row-actions">
                                <button type="button" class="nf-icon-button" title="@T[InfernoWebLocalizableStrings.General.Edit]" @onclick="() => Edit(block)">
                                    <Icon Name="edit" Size="16" />
                                </button>
                                <button type="button" class="nf-icon-button nf-danger-hover" title="@T[InfernoWebLocalizableStrings.General.Delete]" @onclick="() => DeleteAsync(block)">
                                    <Icon Name="trash" Size="16" />
                                </button>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </Table>
}

<Drawer Open="editing is not null" Scrim="true" Width="min(720px, 100vw)" OnClose="Close"
        Title="@(isNew ? T[InfernoCmsLocalizableStrings.ContentBlocks.NewBlock].Value : T[InfernoWebLocalizableStrings.General.EditFormat, editing?.Title ?? string.Empty].Value)">
    <ChildContent>
        @if (editing is not null)
        {
            <EditForm id="entity-block-form" Model="editing" OnValidSubmit="SaveAsync">
                @if (isNew)
                {
                    <ContentBlockFields Block="editing" IsNew="true" BlockTypes="blockTypes" Zones="zones" Errors="errors" />
                    <EntityTargetFields @bind-EntityType="entityType" @bind-EntityId="entityId" Errors="errors" />
                    <p class="nf-hint">@T[InfernoCmsLocalizableStrings.ContentBlocks.SettingsAfterCreate]</p>
                }
                else
                {
                    <TabSet @bind-ActiveTab="activeTab" KeepPanelsMounted="true">
                        <Tab Id="details" Title="@T[InfernoWebLocalizableStrings.General.Details]" Icon="edit">
                            <ContentBlockFields Block="editing" BlockTypes="blockTypes" Zones="zones" Errors="errors" />
                            <EntityTargetFields @bind-EntityType="entityType" @bind-EntityId="entityId" Errors="errors" />
                        </Tab>
                        <Tab Id="settings" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.BlockSettings]" Icon="sliders">
                            @if (editorType is not null)
                            {
                                <DynamicComponent @ref="blockEditor" Type="editorType" Parameters="@(new Dictionary<string, object> { ["Data"] = editing })" />
                            }
                            else
                            {
                                <EmptyState Icon="sliders" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.NoSettings]" />
                            }
                        </Tab>
                    </TabSet>
                }
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="Close">@T[InfernoWebLocalizableStrings.General.Cancel]</button>
        <button type="submit" form="entity-block-form" class="nf-button nf-button-primary" disabled="@saving">
            <Icon Name="save" Size="16" /> @(isNew ? T[InfernoCmsLocalizableStrings.ContentBlocks.CreateAndConfigure] : T[InfernoWebLocalizableStrings.General.Save])
        </button>
    </Footer>
</Drawer>

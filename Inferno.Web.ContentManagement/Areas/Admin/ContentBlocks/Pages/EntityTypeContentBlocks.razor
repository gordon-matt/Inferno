@page "/admin/blocks/entity-type-content-blocks"
@inherits RadzenDataPage<EntityTypeContentBlock, Guid>

<h1>@T[InfernoCmsLocalizableStrings.ContentBlocks.EntityTypeContentBlocks]</h1>

<div class="row" hidden="@(ShowEditMode == true || ShowCreateMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
    </div>
    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="EntityTypeContentBlock"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="10"
                        ColumnWidth="200px">
            <Columns>
                <RadzenDataGridColumn TItem="EntityTypeContentBlock" Property="Title" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Title]" />
                <RadzenDataGridColumn TItem="EntityTypeContentBlock" Property="EntityType" Title="Entity type" />
                <RadzenDataGridColumn TItem="EntityTypeContentBlock" Property="EntityId" Title="Entity id" />
                <RadzenDataGridColumn TItem="EntityTypeContentBlock" Property="BlockName" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.BlockType]" />
                <RadzenDataGridColumn TItem="EntityTypeContentBlock" Property="Order" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Order]" />
                <RadzenDataGridColumn TItem="EntityTypeContentBlock" Property="IsEnabled" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.IsEnabled]" />
                <RadzenDataGridColumn TItem="EntityTypeContentBlock" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="50px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(args => EditAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(args => DeleteAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" hidden="@(ShowCreateMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">Details</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Title]</label>
                        <div class="col-md-9">
                            <RadzenTextBox @bind-Value="Model.Title" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">Entity type</label>
                        <div class="col-md-9">
                            <RadzenTextBox @bind-Value="Model.EntityType" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">Entity id</label>
                        <div class="col-md-9">
                            <RadzenTextBox @bind-Value="Model.EntityId" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.BlockType]</label>
                        <div class="col-md-9">
                            <RadzenDropDown @bind-Value="Model.BlockType" Data="BlockTypesSelectList" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Order]</label>
                        <div class="col-md-9">
                            <RadzenNumeric @bind-Value="Model.Order" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.ZoneId]</label>
                        <div class="col-md-9">
                            <RadzenDropDown @bind-Value="Model.ZoneId" Data="ZonesSelectList" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                        </div>
                    </div>
                    <div class="mb-3 float-end">
                        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">@T[InfernoWebLocalizableStrings.General.Cancel]</RadzenButton>
                        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">@T[InfernoWebLocalizableStrings.General.Save]</RadzenButton>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<div class="row" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">Details</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Title]</label>
                        <div class="col-md-9">
                            <RadzenTextBox @bind-Value="Model.Title" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">Entity type</label>
                        <div class="col-md-9">
                            <RadzenTextBox @bind-Value="Model.EntityType" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">Entity id</label>
                        <div class="col-md-9">
                            <RadzenTextBox @bind-Value="Model.EntityId" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Order]</label>
                        <div class="col-md-9">
                            <RadzenNumeric @bind-Value="Model.Order" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.ZoneId]</label>
                        <div class="col-md-9">
                            <RadzenDropDown @bind-Value="Model.ZoneId" Data="ZonesSelectList" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-9 offset-md-3">
                            <div class="form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input me-2" type="checkbox" @bind="Model.IsEnabled" />
                                    @T[InfernoCmsLocalizableStrings.ContentBlocks.Model.IsEnabled]
                                </label>
                            </div>
                        </div>
                    </div>
                    @if (EditorType is not null && EditorData is not null)
                    {
                        <DynamicComponent @ref="BlockEditor" Type="EditorType" Parameters="@(new Dictionary<string, object> { { "Data", EditorData } })" />
                    }
                    <div class="mb-3 float-end">
                        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">@T[InfernoWebLocalizableStrings.General.Cancel]</RadzenButton>
                        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">@T[InfernoWebLocalizableStrings.General.Save]</RadzenButton>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@page "/admin/blocks/content-blocks"
@inherits RadzenDataPage<ContentBlock, Guid>

<h1>Content Blocks</h1>

<div class="row" hidden="@(ShowEditMode == true || ShowCreateMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
    </div>

    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="ContentBlock"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="10"
                        ColumnWidth="200px">
            <Columns>
                <RadzenDataGridColumn TItem="ContentBlock" Property="Title" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Title]" />
                <RadzenDataGridColumn TItem="ContentBlock" Property="BlockName" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.BlockType]" />
                <RadzenDataGridColumn TItem="ContentBlock" Property="Order" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Order]" />
                <RadzenDataGridColumn TItem="ContentBlock" Property="IsEnabled" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.IsEnabled]" />
                <RadzenDataGridColumn TItem="ContentBlock" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="50px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(args => EditAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(args => DeleteAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="create-form-section" hidden="@(ShowCreateMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">Details</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Title">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Title]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.Title" Style="width:100%" Name="Create_Title" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="BlockType">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.BlockType]</label>
                                <div class="col-md-9">
                                    <RadzenDropDown @bind-Value="Model.BlockType" Data="BlockTypesSelectList" TextProperty="Name" ValueProperty="Id" Name="Create_BlockType" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Order">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Order]</label>
                                <div class="col-md-9">
                                    <RadzenNumeric @bind-Value="Model.Order" Style="width:100%" Name="Create_Order" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="ZoneId">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.ZoneId]</label>
                                <div class="col-md-9">
                                    <RadzenDropDown @bind-Value="Model.ZoneId" Data="ZonesSelectList" TextProperty="Name" ValueProperty="Id" Name="Create_ZoneId" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<div class="row" id="edit-form-section" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">Details</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Title">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Title]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.Title" Style="width:100%" ReadOnly="true" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="CustomTemplatePath">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.CustomTemplatePath]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.CustomTemplatePath" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Order">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.Order]</label>
                                <div class="col-md-9">
                                    <RadzenNumeric @bind-Value="Model.Order" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="ZoneId">@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.ZoneId]</label>
                                <div class="col-md-9">
                                    <RadzenDropDown @bind-Value="Model.ZoneId" Data="ZonesSelectList" TextProperty="Name" ValueProperty="Id" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="IsEnabled"></label>
                                <div class="col-md-9">
                                    <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.IsEnabled" />@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.IsEnabled]</label></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (EditorType is not null)
                    {
                        <div id="block-details">
                            <DynamicComponent Type="EditorType" Parameters="@(new Dictionary<string, object> { { "Data", Model } })" />
                        </div>
                    }
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
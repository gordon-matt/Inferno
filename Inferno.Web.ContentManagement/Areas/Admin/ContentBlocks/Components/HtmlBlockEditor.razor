@using Pickstack
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks
@inherits ContentBlockEditor<HtmlBlock>

<Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.HtmlBlock.BodyContent]" For="html-body">
    <PickstackEditor Value="@Model.BodyContent" ValueChanged="@(value => Model.BodyContent = value)" Height="420" FileRoot="@WorkContext.TenantRoot" />
    <span class="nf-hint">@T[InfernoCmsLocalizableStrings.ContentBlocks.HtmlBlock.HelpText.BodyContent]</span>
</Field>

<Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.HtmlBlock.Script]" For="html-script">
    <InputTextArea id="html-script" class="nf-textarea nf-textarea-code" rows="6" @bind-Value="Model.Script" />
    <span class="nf-hint">@T[InfernoCmsLocalizableStrings.ContentBlocks.HtmlBlock.HelpText.Script]</span>
</Field>

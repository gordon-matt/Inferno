@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks

@foreach (var contentBlock in contentBlocks.OrderBy(x => x.Order))
{
    Type displayType = null;
    if (!string.IsNullOrEmpty(contentBlock.CustomDisplayType))
    {
        displayType = Type.GetType(contentBlock.CustomDisplayType, throwOnError: false);
    }

    displayType ??= contentBlock.DisplayType;
    if (displayType != null)
    {
        <DynamicComponent Type="displayType" Parameters="@(new Dictionary<string, object> { { "Model", contentBlock } })" />
    }
}

@code {
    [Parameter]
    public string ZoneName { get; set; }

    [Parameter]
    public string EntityType { get; set; }

    [Parameter]
    public string EntityId { get; set; }

    [Inject]
    private IEnumerable<IEntityTypeContentBlockProvider> Providers { get; set; }

    private IEnumerable<IContentBlock> contentBlocks = [];

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(ZoneName) || string.IsNullOrWhiteSpace(EntityType) || string.IsNullOrWhiteSpace(EntityId))
        {
            contentBlocks = [];
            return;
        }

        contentBlocks = Providers
            .SelectMany(x => x.GetContentBlocks(ZoneName, EntityType, EntityId) ?? [])
            .Where(x => x != null && x.Enabled)
            .ToList();
    }
}

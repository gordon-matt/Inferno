<Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.EntityType]" For="block-entity-type">
    <input id="block-entity-type" class="nf-input inferno-code" value="@EntityType" @onchange="args => EntityTypeChanged.InvokeAsync(args.Value?.ToString())" />
    <span class="nf-hint">@T[InfernoCmsLocalizableStrings.ContentBlocks.EntityTypeHint]</span>
    <ErrorText Errors="Errors" Key="EntityType" />
</Field>

<Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.Model.EntityId]" For="block-entity-id">
    <input id="block-entity-id" class="nf-input inferno-code" value="@EntityId" @onchange="args => EntityIdChanged.InvokeAsync(args.Value?.ToString())" />
    <ErrorText Errors="Errors" Key="EntityId" />
</Field>

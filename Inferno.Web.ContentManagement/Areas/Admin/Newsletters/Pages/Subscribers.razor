@page "/admin/newsletters/subscribers"
@attribute [Authorize(Policy = CmsConstants.Policies.NewsletterRead)]
@inherits AdminPage

<PageTitle>@T[InfernoCmsLocalizableStrings.Newsletters.Subscribers]</PageTitle>

<PageHeader Title="@T[InfernoCmsLocalizableStrings.Newsletters.Subscribers]" Icon="mail" Description="@T[InfernoCmsLocalizableStrings.Newsletters.Description]">
    <Actions>
        @if (subscribers?.Count > 0)
        {
            <a class="nf-button" href="@ExportUrl" download="">
                <Icon Name="download" Size="16" /> @T[InfernoCmsLocalizableStrings.Newsletters.ExportToCSV]
            </a>
        }
    </Actions>
</PageHeader>

<div class="nf-toolbar">
    <SearchField Value="@search" ValueChanged="SearchChangedAsync" Placeholder="@T[InfernoWebLocalizableStrings.Admin.SearchPlaceholder]" />
    @if (subscribers is not null)
    {
        <span class="nf-muted">@T[InfernoCmsLocalizableStrings.Newsletters.CountFormat, subscribers.Count]</span>
    }
</div>

@if (subscribers is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (subscribers.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(search))
    {
        <EmptyState Icon="mail" Title="@T[InfernoCmsLocalizableStrings.Newsletters.EmptyTitle]" Description="@T[InfernoCmsLocalizableStrings.Newsletters.EmptyDescription]" />
    }
    else
    {
        <EmptyState Icon="search" Title="@T[InfernoWebLocalizableStrings.Admin.NoMatchesTitle]" Description="@T[InfernoWebLocalizableStrings.Admin.NoMatchesDescription]" />
    }
}
else
{
    <Table>
        <thead>
            <tr>
                <th>@T[InfernoWebLocalizableStrings.General.Name]</th>
                <th>@T[InfernoCmsLocalizableStrings.ContentBlocks.NewsletterSubscriptionBlock.Email]</th>
                <th class="nf-cell-actions"><span class="nf-sr-only">@T[InfernoWebLocalizableStrings.General.Actions]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subscriber in subscribers)
            {
                <tr @key="subscriber.Id">
                    <td class="nf-row-title">@subscriber.Name</td>
                    <td><a href="mailto:@subscriber.Email">@subscriber.Email</a></td>
                    <td class="nf-cell-actions">
                        @if (canWrite)
                        {
                            <button type="button" class="nf-icon-button nf-danger-hover" title="@T[InfernoCmsLocalizableStrings.Newsletters.Unsubscribe]" @onclick="() => UnsubscribeAsync(subscriber)">
                                <Icon Name="x" Size="16" />
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </Table>
}

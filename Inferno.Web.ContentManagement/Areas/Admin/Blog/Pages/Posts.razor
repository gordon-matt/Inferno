@page "/admin/blog/posts"
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Entities
@inherits RadzenDataPage<BlogPost, Guid>

<h1>@T[InfernoCmsLocalizableStrings.Blog.Posts]</h1>

<div class="row" hidden="@(ShowEditMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
    </div>

    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="BlogPost"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="20"
                        ColumnWidth="180px">
            <Columns>
                <RadzenDataGridColumn TItem="BlogPost" Property="Headline" Title="@T[InfernoCmsLocalizableStrings.Blog.PostModel.Headline]" />
                <RadzenDataGridColumn TItem="BlogPost" Property="CategoryId" Title="@T[InfernoCmsLocalizableStrings.Blog.PostModel.CategoryId]" Filterable="false" Sortable="false" Width="180px">
                    <Template Context="record">
                        @(GetCategoryName(record.CategoryId))
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BlogPost" Property="Slug" Title="@T[InfernoCmsLocalizableStrings.Blog.PostModel.Slug]" />
                <RadzenDataGridColumn TItem="BlogPost" Property="DateCreatedUtc" Title="@T[InfernoCmsLocalizableStrings.Blog.PostModel.DateCreatedUtc]" Width="180px">
                    <Template Context="record">
                        @record.DateCreatedUtc.ToString("yyyy-MM-dd HH:mm")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BlogPost" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="120px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(() => EditAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(() => DeleteAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="form-section" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">@T[InfernoWebLocalizableStrings.General.Details]</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Blog.PostModel.Headline]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.Headline" Style="width:100%" Name="Headline" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Blog.PostModel.Slug]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.Slug" Style="width:100%" Name="Slug" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Blog.PostModel.CategoryId]</label>
                                <div class="col-md-8">
                                    <RadzenDropDown @bind-Value="Model.CategoryId"
                                                    Data="CategoriesSelectList"
                                                    TextProperty="Name"
                                                    ValueProperty="Id"
                                                    Style="width:100%"
                                                    Name="CategoryId" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Blog.Tags]</label>
                                <div class="col-md-8">
                                    <RadzenDropDown TValue="IEnumerable<int>"
                                                    Data="TagsSelectList"
                                                    TextProperty="Name"
                                                    ValueProperty="Id"
                                                    Multiple="true"
                                                    AllowClear="true"
                                                    Chips="true"
                                                    @bind-Value="SelectedTagIds"
                                                    Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-2">@T[InfernoCmsLocalizableStrings.Blog.PostModel.TeaserImageUrl]</label>
                                <div class="col-md-10">
                                    <RadzenTextBox @bind-Value="Model.TeaserImageUrl" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-2">@T[InfernoCmsLocalizableStrings.Blog.PostModel.ShortDescription]</label>
                                <div class="col-md-10">
                                    <RadzenTextArea @bind-Value="Model.ShortDescription" Rows="3" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-2">@T[InfernoCmsLocalizableStrings.Blog.PostModel.FullDescription]</label>
                                <div class="col-md-10">
                                    <PickstackScripts />
                                    <PickstackEditor @bind-Value="Model.FullDescription" FileRoot="@WorkContext.TenantRoot" Height="400" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.UseExternalLink" />@T[InfernoCmsLocalizableStrings.Blog.PostModel.UseExternalLink]</label></div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Blog.PostModel.ExternalLink]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.ExternalLink" Style="width:100%" Disabled="@(!Model.UseExternalLink)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Blog.PostModel.MetaKeywords]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.MetaKeywords" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Blog.PostModel.MetaDescription]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.MetaDescription" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@using BlogKrafter.Posts
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@inherits ContentBlockDisplay<LastNPostsBlock>

@inject IBlogReader Reader

<div class="row">
    <div class="col-12 mb-3">
        <div class="card">
            <div class="card-body">
                <ul class="mb-0">
                    @foreach (var entry in entries)
                    {
                        <li><a href="/blog/@entry.Slug">@entry.Title</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<BlogKrafter.Models.PostSummaryDto> entries = [];

    protected override async Task OnInitializedAsync()
    {
        var recent = await Reader.GetRecentPostsAsync(Model.NumberOfEntries);
        entries = recent.IsSuccess ? recent.Value : [];
        await base.OnInitializedAsync();
    }
}

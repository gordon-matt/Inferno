@inherits ContentBlockEditor<CategoriesBlock>

<Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.CategoriesBlock.NumberOfCategories]" For="categories-count">
    <InputNumber id="categories-count" class="nf-input" min="0" max="255" @bind-Value="NumberOfCategories" />
    <span class="nf-hint">@T[InfernoCmsLocalizableStrings.ContentBlocks.ZeroMeansAll]</span>
</Field>

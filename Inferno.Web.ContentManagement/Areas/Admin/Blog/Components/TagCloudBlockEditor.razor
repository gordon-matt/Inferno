@using Inferno.Web.ContentManagement.Areas.Admin.Blog.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@inherits ContentBlockEditor<TagCloudBlock>

<TabSet KeepPanelsMounted="true" AriaLabel="@T[InfernoCmsLocalizableStrings.ContentBlocks.BlockSettings]">
    <Tab Id="tag-cloud-layout" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Layout]">
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Shape]" For="tag-cloud-shape">
            <InputSelect id="tag-cloud-shape" class="nf-select nf-select-block" @bind-Value="Model.Shape">
                @foreach (var shape in Enum.GetValues<CloudShape>())
                {
                    <option value="@shape">@shape</option>
                }
            </InputSelect>
        </Field>
        <div class="nf-form-row">
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Steps]" For="tag-cloud-steps">
                <InputNumber id="tag-cloud-steps" class="nf-input" min="1" max="255" @bind-Value="Steps" />
            </Field>
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Delay]" For="tag-cloud-delay">
                <InputNumber id="tag-cloud-delay" class="nf-input" min="0" max="255" @bind-Value="Delay" />
            </Field>
        </div>
        <Switch @bind-Value="Model.AutoResize" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.AutoResize]" />
        <Switch @bind-Value="Model.RemoveOverflowing" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.RemoveOverflowing]" />
        <Switch @bind-Value="Model.EncodeURI" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.EncodeURI]" />
    </Tab>

    <Tab Id="tag-cloud-style" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Appearance]">
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Colors]" For="tag-cloud-colors">
            <InputText id="tag-cloud-colors" class="nf-input inferno-code" @bind-Value="Model.Colors" placeholder="#800026,#bd0026,#e31a1c" />
        </Field>
        <div class="nf-form-row">
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.FontSizeFrom]" For="tag-cloud-font-from">
                <InputNumber id="tag-cloud-font-from" class="nf-input" step="0.01" min="0" @bind-Value="Model.FontSizeFrom" />
            </Field>
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.FontSizeTo]" For="tag-cloud-font-to">
                <InputNumber id="tag-cloud-font-to" class="nf-input" step="0.01" min="0" @bind-Value="Model.FontSizeTo" />
            </Field>
        </div>
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.ClassPattern]" For="tag-cloud-class">
            <InputText id="tag-cloud-class" class="nf-input inferno-code" @bind-Value="Model.ClassPattern" placeholder="w{n}" />
        </Field>
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.AfterCloudRender]" For="tag-cloud-after">
            <InputTextArea id="tag-cloud-after" class="nf-textarea nf-textarea-code" rows="4" @bind-Value="Model.AfterCloudRender" />
        </Field>
    </Tab>
</TabSet>

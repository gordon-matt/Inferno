@using Inferno.Models;
@using Inferno.Web.Components
@using Inferno.Web.ContentManagement.Areas.Admin.Blog
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components;
@inherits ContentBlockEditor<TagCloudBlock>

<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="AutoResize"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.AutoResize" />@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.AutoResize]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="RemoveOverflowing"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.RemoveOverflowing" />@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.RemoveOverflowing]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="EncodeURI"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.EncodeURI" />@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.EncodeURI]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Steps">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Steps]</label>
            <div class="col-md-9">
                <RadzenNumeric @bind-Value="Model.Steps" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ClassPattern">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.ClassPattern]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.ClassPattern" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="AfterCloudRender">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.AfterCloudRender]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.AfterCloudRender" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Delay">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Delay]</label>
            <div class="col-md-9">
                <RadzenNumeric @bind-Value="Model.Delay" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Shape">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Shape]</label>
            <div class="col-md-9">
                <RadzenDropDown Data=@availableShapes TValue="IdNamePair<byte>" TextProperty="Name" ValueProperty="Id" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Colors">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Colors]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.Colors" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Delay">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.Delay]</label>
            <div class="col-md-9">
                <RadzenNumeric @bind-Value="Model.Delay" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="FontSizeFrom">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.FontSizeFrom]</label>
            <div class="col-md-9">
                <RadzenNumeric @bind-Value="Model.FontSizeFrom" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="FontSizeTo">@T[InfernoCmsLocalizableStrings.ContentBlocks.TagCloudBlock.FontSizeTo]</label>
            <div class="col-md-9">
                <RadzenNumeric @bind-Value="Model.FontSizeTo" Style="width:100%" />
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<IdNamePair<byte>> availableShapes;

    protected override async Task OnInitializedAsync()
    {
        availableShapes = Extenso.EnumExtensions.GetValues<CloudShape>().Select(x => new IdNamePair<byte> { Id = (byte)x, Name = x.ToString() });
        await base.OnInitializedAsync();
    }
}
@using BlogKrafter.Models
@using BlogKrafter.Posts
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@inherits ContentBlockDisplay<FilteredPostsBlock>

@inject IBlogReader Reader

@if (posts.Count > 0)
{
    <ul class="list-unstyled">
        @foreach (var post in posts)
        {
            <li class="mb-2"><a href="/blog/@post.Slug">@post.Title</a></li>
        }
    </ul>
}

@code {
    private IReadOnlyList<PostSummaryDto> posts = [];

    protected override async Task OnInitializedAsync()
    {
        posts = [];
        string tagSlug = null;
        string categorySlug = null;

        if (Model.FilterType == FilterType.Category && Model.CategoryId is int categoryId)
        {
            var categories = await Reader.GetCategoriesAsync();
            categorySlug = categories.IsSuccess
                ? categories.Value.FirstOrDefault(item => item.Id == categoryId)?.Slug
                : null;
            if (categorySlug is null)
            {
                return;
            }
        }
        else if (Model.FilterType == FilterType.Tag && Model.TagId is int tagId)
        {
            var tags = await Reader.GetTagsAsync();
            tagSlug = tags.IsSuccess
                ? tags.Value.FirstOrDefault(item => item.Id == tagId)?.Slug
                : null;
            if (tagSlug is null)
            {
                return;
            }
        }

        var recent = await Reader.GetRecentPostsAsync(20, tagSlug, categorySlug);
        posts = recent.IsSuccess ? recent.Value : [];
    }
}

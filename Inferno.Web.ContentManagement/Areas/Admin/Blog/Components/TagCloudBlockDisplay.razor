@using BlogKrafter.Posts
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@inherits ContentBlockDisplay<TagCloudBlock>

@inject IBlogReader Reader

<div class="card mb-3">
    <div class="card-header">@T[InfernoCmsLocalizableStrings.Blog.Tags]</div>
    <div class="card-body tag-cloud">
        @foreach (var word in words)
        {
            <a class="@word.CssClass" href="/blog/tag/@word.Slug" style="font-size:@word.FontSize">@word.Name</a>
        }
    </div>
</div>

@code {
    private List<CloudWord> words = [];

    protected override async Task OnInitializedAsync()
    {
        words = [];
        var tags = await Reader.GetTagsAsync();
        if (!tags.IsSuccess || tags.Value.Count == 0)
        {
            return;
        }

        int min = tags.Value.Min(tag => tag.PostCount);
        int max = tags.Value.Max(tag => tag.PostCount);
        int steps = Model.Steps <= 0 ? 10 : Model.Steps;

        foreach (var tag in tags.Value.OrderBy(tag => tag.Name))
        {
            int weight = max == min
                ? steps
                : 1 + (int)Math.Round((tag.PostCount - min) / (double)(max - min) * (steps - 1));
            string css = string.IsNullOrWhiteSpace(Model.ClassPattern)
                ? null
                : Model.ClassPattern.Replace("{n}", weight.ToString(), StringComparison.Ordinal);
            words.Add(new CloudWord(
                tag.Name,
                tag.Slug,
                css,
                (0.8 + (weight / (double)steps)).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + "rem"));
        }
    }

    private sealed record CloudWord(string Name, string Slug, string CssClass, string FontSize);
}

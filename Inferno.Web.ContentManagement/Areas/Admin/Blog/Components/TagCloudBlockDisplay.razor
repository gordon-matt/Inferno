@using Inferno.Web.ContentManagement.Areas.Admin.Blog.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Entities
@using Inferno.Web.ContentManagement.Areas.Admin.Blog.Services
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@inherits ContentBlockDisplay<TagCloudBlock>
@inject IBlogPostTagService PostTagService
@inject IBlogTagService TagService
@inject IWorkContext WorkContext

<div class="card mb-3">
    <div class="card-header">@T[InfernoCmsLocalizableStrings.Blog.Tags]</div>
    <div class="card-body tag-cloud">
        @foreach (var word in words)
        {
            <a class="@word.CssClass" href="/blog/tag/@word.Slug" style="font-size:@word.FontSize">@word.Name</a>
        }
    </div>
</div>

@code {
    private List<CloudWord> words = [];

    protected override void OnParametersSet()
    {
        words = [];
        if (WorkContext.CurrentTenant == null)
        {
            return;
        }

        List<int> tagIds;
        using (var connection = PostTagService.OpenConnection())
        {
            tagIds = connection.Query().Select(x => x.TagId).ToList();
        }

        var counts = tagIds.GroupBy(x => x).ToDictionary(x => x.Key, x => x.Count());

        Dictionary<int, BlogTag> tags;
        using (var connection = TagService.OpenConnection())
        {
            int tenantId = WorkContext.CurrentTenant.Id;
            tags = connection.Query(x => x.TenantId == tenantId).ToDictionary(x => x.Id);
        }

        if (counts.Count == 0)
        {
            return;
        }

        int min = counts.Values.Min();
        int max = counts.Values.Max();
        int steps = Model.Steps <= 0 ? 10 : Model.Steps;

        foreach (var pair in counts.OrderBy(x => tags.TryGetValue(x.Key, out var tag) ? tag.Name : string.Empty))
        {
            if (!tags.TryGetValue(pair.Key, out var tag))
            {
                continue;
            }

            int weight = max == min
                ? steps
                : 1 + (int)Math.Round((pair.Value - min) / (double)(max - min) * (steps - 1));
            string css = string.IsNullOrWhiteSpace(Model.ClassPattern)
                ? null
                : Model.ClassPattern.Replace("{n}", weight.ToString(), StringComparison.Ordinal);
            words.Add(new CloudWord(tag.Name, tag.UrlSlug, css, (0.8 + (weight / (double)steps)).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + "rem"));
        }
    }

    private sealed record CloudWord(string Name, string Slug, string CssClass, string FontSize);
}

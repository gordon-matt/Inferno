@using Inferno.Web.ContentManagement.Areas.Admin.Blog.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@inherits ContentBlockEditor<FilteredPostsBlock>

<Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.AllPostsBlock.FilterType]" For="filtered-posts-type">
    <InputSelect id="filtered-posts-type" class="nf-select nf-select-block" @bind-Value="Model.FilterType">
        <option value="@FilterType.None">@T[InfernoCmsLocalizableStrings.ContentBlocks.AllPostsBlock.AllPosts]</option>
        <option value="@FilterType.Category">@T[InfernoCmsLocalizableStrings.ContentBlocks.AllPostsBlock.CategoryId]</option>
        <option value="@FilterType.Tag">@T[InfernoCmsLocalizableStrings.ContentBlocks.AllPostsBlock.TagId]</option>
    </InputSelect>
</Field>

@if (Model.FilterType == FilterType.Category)
{
    <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.AllPostsBlock.CategoryId]" For="filtered-posts-category">
        <InputSelect id="filtered-posts-category" class="nf-select nf-select-block" @bind-Value="Model.CategoryId">
            <option value="">—</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </InputSelect>
    </Field>
}
else if (Model.FilterType == FilterType.Tag)
{
    <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.AllPostsBlock.TagId]" For="filtered-posts-tag">
        <InputSelect id="filtered-posts-tag" class="nf-select nf-select-block" @bind-Value="Model.TagId">
            <option value="">—</option>
            @foreach (var tag in tags)
            {
                <option value="@tag.Id">@tag.Name</option>
            }
        </InputSelect>
    </Field>
}

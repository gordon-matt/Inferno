@using Inferno.Models
@using Inferno.Web.Components
@using Inferno.Web.ContentManagement.Areas.Admin.Media
@using Inferno.Web.ContentManagement.Areas.Admin.Media.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@using Orientation = Radzen.Orientation
@inherits ContentBlockEditor<VideoBlock>

<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ControlId">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ControlId]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.ControlId" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Source">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Source]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.Source" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="AutomaticallyHideControls"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.AutomaticallyHideControls" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.AutomaticallyHideControls]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="AutoPause"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.AutoPause" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.AutoPause]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="AutoPlay"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.AutoPlay" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.AutoPlay]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ClickToPlay"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.ClickToPlay" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ClickToPlay]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Controls"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.Controls" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Controls]</label></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ControlsList"></label>
            <div class="col-md-9">
                <RadzenCheckBoxList @bind-Value="Model.ControlsList" TValue="string" Orientation="Orientation.Vertical" Data="@availableControls" TextProperty="Name" ValueProperty="Id" />
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="DisableContextMenu"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.DisableContextMenu" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.DisableContextMenu]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="InvertTime"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.InvertTime" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.InvertTime]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Muted"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.Muted" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Muted]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Poster">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Poster]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.Poster" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ProtectionData">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionData]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.ProtectionData" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ProtectionHttpRequestHeaders">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionHttpRequestHeaders]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.ProtectionHttpRequestHeaders" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ProtectionServerUrl">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionServerUrl]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.ProtectionServerUrl" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ProtectionType">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionType]</label>
            <div class="col-md-9">
                <RadzenDropDown Data="videoProtectionTypeValues" @bind-Value="Model.ProtectionType" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Ratio">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Ratio]</label>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="Model.Ratio" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="ResetOnEnd"></label>
            <div class="col-md-9">
                <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.ResetOnEnd" />@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ResetOnEnd]</label></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="SeekTime">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.SeekTime]</label>
            <div class="col-md-9">
                <RadzenNumeric @bind-Value="Model.SeekTime" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="StreamingLibrary">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.StreamingLibrary]</label>
            <div class="col-md-9">
                <RadzenDropDown Data="streamingLibraryValues" @bind-Value="Model.StreamingLibrary" Style="width:100%" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="row mb-3">
            <label class="col-form-label col-md-3" for="Volume">@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Volume]</label>
            <div class="col-md-9">
                <RadzenSlider @bind-Value="Model.Volume" Min="0" Max="1" Step="0.1" Style="width:100%" />
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<IdNamePair<string>> availableControls = new List<IdNamePair<string>>
    {
        new IdNamePair<string>{ Id = VideoControlsType.PlayLarge, Name = "Play (Large)" },
        new IdNamePair<string>{ Id = VideoControlsType.Restart, Name = "Restart" },
        new IdNamePair<string>{ Id = VideoControlsType.Rewind, Name = "Rewind" },
        new IdNamePair<string>{ Id = VideoControlsType.Play, Name = "Play" },
        new IdNamePair<string>{ Id = VideoControlsType.FastForward, Name = "Fast Forward" },
        new IdNamePair<string>{ Id = VideoControlsType.Progress, Name = "Progress" },
        new IdNamePair<string>{ Id = VideoControlsType.CurrentTime, Name = "Current Time" },
        new IdNamePair<string>{ Id = VideoControlsType.Duration, Name = "Duration" },
        new IdNamePair<string>{ Id = VideoControlsType.Mute, Name = "Mute" },
        new IdNamePair<string>{ Id = VideoControlsType.Volume, Name = "Volume" },
        new IdNamePair<string>{ Id = VideoControlsType.Captions, Name = "Captions" },
        new IdNamePair<string>{ Id = VideoControlsType.Settings, Name = "Settings" },
        new IdNamePair<string>{ Id = VideoControlsType.Pip, Name = "Picture-in-Picture" },
        new IdNamePair<string>{ Id = VideoControlsType.Airplay, Name = "Airplay (Safari only)" },
        new IdNamePair<string>{ Id = VideoControlsType.Download, Name = "Download" },
        new IdNamePair<string>{ Id = VideoControlsType.Fullscreen, Name = "Fullscreen" },
    };

    private IEnumerable<VideoProtectionType> videoProtectionTypeValues = Extenso.EnumExtensions.GetValues<VideoProtectionType>();
    private IEnumerable<StreamingLibrary> streamingLibraryValues = Extenso.EnumExtensions.GetValues<StreamingLibrary>();
}
@using System.Globalization
@using Inferno.Web.ContentManagement.Areas.Admin.Media.ContentBlocks
@using Inferno.Web.ContentManagement.Areas.Admin.ContentBlocks.Components
@inherits ContentBlockEditor<VideoBlock>

<TabSet KeepPanelsMounted="true" AriaLabel="@T[InfernoCmsLocalizableStrings.ContentBlocks.BlockSettings]">
    <Tab Id="video-source" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Source]">
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Source]" For="video-source-url">
            <InputText id="video-source-url" class="nf-input" @bind-Value="Model.Source" placeholder="https://" />
        </Field>
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Poster]" For="video-poster">
            <InputText id="video-poster" class="nf-input" @bind-Value="Model.Poster" />
        </Field>
        <div class="nf-form-row">
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Ratio]" For="video-ratio">
                <InputText id="video-ratio" class="nf-input" @bind-Value="Model.Ratio" placeholder="16:9" />
            </Field>
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ControlId]" For="video-control-id">
                <InputText id="video-control-id" class="nf-input inferno-code" @bind-Value="Model.ControlId" />
            </Field>
        </div>
    </Tab>

    <Tab Id="video-playback" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Playback]">
        <Switch @bind-Value="Model.AutoPlay" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.AutoPlay]" />
        <Switch @bind-Value="Model.Muted" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Muted]" />
        <Switch @bind-Value="Model.AutoPause" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.AutoPause]" />
        <Switch @bind-Value="Model.ClickToPlay" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ClickToPlay]" />
        <Switch @bind-Value="Model.ResetOnEnd" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ResetOnEnd]" />
        <Switch @bind-Value="Model.InvertTime" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.InvertTime]" />
        <div class="nf-form-row">
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.SeekTime]" For="video-seek">
                <InputNumber id="video-seek" class="nf-input" min="0" @bind-Value="Model.SeekTime" />
            </Field>
            <Field Label="@($"{T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Volume]} ({Model.Volume:P0})")" For="video-volume">
                <input id="video-volume" type="range" class="nf-range" min="0" max="1" step="0.1"
                       @bind-value="Model.Volume" @bind-value:event="oninput" @bind-value:culture="CultureInfo.InvariantCulture" />
            </Field>
        </div>
    </Tab>

    <Tab Id="video-controls" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Controls]">
        <Switch @bind-Value="Model.Controls" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Controls]" />
        <Switch @bind-Value="Model.AutomaticallyHideControls" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.AutomaticallyHideControls]" />
        <Switch @bind-Value="Model.DisableContextMenu" Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.DisableContextMenu]" />
        @if (Model.Controls)
        {
            <fieldset class="nf-check-grid">
                <legend>@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ControlsList]</legend>
                @foreach (var control in availableControls)
                {
                    <label class="nf-check">
                        <input type="checkbox" checked="@IsControlSelected(control.Id)" @onchange="args => ToggleControl(control.Id, args)" />
                        @control.Name
                    </label>
                }
            </fieldset>
        }
    </Tab>

    <Tab Id="video-protection" Title="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.Protection]">
        <div class="nf-form-row">
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.StreamingLibrary]" For="video-streaming">
                <InputSelect id="video-streaming" class="nf-select nf-select-block" @bind-Value="Model.StreamingLibrary">
                    @foreach (var value in Enum.GetValues<StreamingLibrary>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </Field>
            <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionType]" For="video-protection-type">
                <InputSelect id="video-protection-type" class="nf-select nf-select-block" @bind-Value="Model.ProtectionType">
                    @foreach (var value in Enum.GetValues<VideoProtectionType>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </Field>
        </div>
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionServerUrl]" For="video-protection-url">
            <InputText id="video-protection-url" class="nf-input" @bind-Value="Model.ProtectionServerUrl" />
        </Field>
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionHttpRequestHeaders]" For="video-protection-headers">
            <InputText id="video-protection-headers" class="nf-input inferno-code" @bind-Value="Model.ProtectionHttpRequestHeaders" />
        </Field>
        <Field Label="@T[InfernoCmsLocalizableStrings.ContentBlocks.VideoBlock.ProtectionData]" For="video-protection-data">
            <InputTextArea id="video-protection-data" class="nf-textarea nf-textarea-code" @bind-Value="Model.ProtectionData" />
        </Field>
    </Tab>
</TabSet>

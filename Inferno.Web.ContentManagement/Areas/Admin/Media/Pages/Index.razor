@page "/admin/media/index"

@inject IWorkContext WorkContext

<div class="inferno-media-browser">
    <iframe title="Media" src="/pickstack/webfilez?root=Tenant_@WorkContext.CurrentTenant.Id&editors=true"></iframe>
</div>

<style>
    body:has(.inferno-media-browser) {
        overflow: hidden;
        height: 100dvh;
    }

    body:has(.inferno-media-browser) .b-layout.b-layout-root {
        height: 100%;
        min-height: 0;
    }

    body:has(.inferno-media-browser) .b-layout-header-fixed {
        position: relative !important;
    }

    body:has(.inferno-media-browser) .b-layout-header-fixed + .b-layout-content {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        margin-top: 0 !important;
        padding: 0 !important;
    }

    .inferno-media-browser {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        width: 100%;
        min-height: 0;
    }

    .inferno-media-browser iframe {
        flex: 1 1 auto;
        width: 100%;
        min-height: 0;
        border: 0;
    }
</style>

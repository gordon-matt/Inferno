@using System.Globalization

<div class="inferno-chart" role="img" aria-label="@Label">
    @foreach (var point in Points)
    {
        <div class="inferno-chart-col">
            <div class="inferno-chart-plot">
                <span class="inferno-chart-bar" style="height: @Height(point.Primary)" title="@point.Label: @point.Primary.ToString("0", CultureInfo.CurrentCulture)"></span>
                @if (point.Secondary is double secondary)
                {
                    <span class="inferno-chart-bar inferno-chart-bar-alt" style="height: @Height(secondary)" title="@point.Label: @secondary.ToString("0", CultureInfo.CurrentCulture)"></span>
                }
            </div>
            <span class="inferno-chart-label">@point.Label</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Label { get; set; } = "Chart";

    [Parameter]
    public IReadOnlyList<ChartPoint> Points { get; set; } = [];

    private double Max => Points.Count == 0 ? 0 : Points.Max(point => Math.Max(point.Primary, point.Secondary ?? 0));

    private string Height(double value)
    {
        double percent = Max <= 0 ? 0 : value / Max * 100;
        return percent.ToString("0.#", CultureInfo.InvariantCulture) + "%";
    }

    public sealed record ChartPoint(string Label, double Primary, double? Secondary = null);
}

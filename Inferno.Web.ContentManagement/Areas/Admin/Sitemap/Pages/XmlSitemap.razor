@page "/admin/sitemap/xml-sitemap"
@attribute [Authorize(Policy = CmsConstants.Policies.SitemapRead)]
@inherits AdminPage
@using System.Globalization
@using Inferno.Web.ContentManagement.Areas.Admin.Sitemap.Entities

<PageTitle>@T[InfernoCmsLocalizableStrings.Sitemap.XMLSitemap]</PageTitle>

<PageHeader Title="@T[InfernoCmsLocalizableStrings.Sitemap.XMLSitemap]" Icon="sitemap" Description="@T[InfernoCmsLocalizableStrings.Sitemap.Description]">
    <Actions>
        <a class="nf-button" href="/sitemap.xml" target="_blank" rel="noopener">
            <Icon Name="external" Size="16" /> @T[InfernoCmsLocalizableStrings.Sitemap.ViewFile]
        </a>
        @if (canWrite)
        {
            <button type="button" class="nf-button nf-button-primary" disabled="@generating" @onclick="GenerateAsync">
                <Icon Name="refresh" Size="16" /> @T[InfernoCmsLocalizableStrings.Sitemap.GenerateFile]
            </button>
        }
    </Actions>
</PageHeader>

<div class="nf-toolbar">
    <SearchField Value="@search" ValueChanged="value => search = value" Placeholder="@T[InfernoWebLocalizableStrings.Admin.SearchPlaceholder]" />
</div>

@if (entries is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (entries.Count == 0)
{
    <EmptyState Icon="sitemap" Title="@T[InfernoCmsLocalizableStrings.Sitemap.EmptyTitle]" Description="@T[InfernoCmsLocalizableStrings.Sitemap.EmptyDescription]" />
}
else if (!Visible.Any())
{
    <EmptyState Icon="search" Title="@T[InfernoWebLocalizableStrings.Admin.NoMatchesTitle]" Description="@T[InfernoWebLocalizableStrings.Admin.NoMatchesDescription]" />
}
else
{
    <Table>
        <thead>
            <tr>
                <th>@T[InfernoCmsLocalizableStrings.Sitemap.Model.Location]</th>
                <th style="width: 220px">@T[InfernoCmsLocalizableStrings.Sitemap.Model.ChangeFrequency]</th>
                <th style="width: 240px">@T[InfernoCmsLocalizableStrings.Sitemap.Model.Priority]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Visible)
            {
                <tr @key="entry.Id">
                    <td class="inferno-code">/@entry.Location</td>
                    <td>
                        <select class="nf-select nf-select-block" disabled="@(!canWrite)" aria-label="@T[InfernoCmsLocalizableStrings.Sitemap.Model.ChangeFrequency]"
                                value="@entry.ChangeFrequency" @onchange="args => ChangeFrequencyChangedAsync(entry, args)">
                            @foreach (var frequency in Enum.GetValues<ChangeFrequency>())
                            {
                                <option value="@frequency">@T[FrequencyKey(frequency)]</option>
                            }
                        </select>
                    </td>
                    <td>
                        <div class="inferno-priority">
                            <input type="range" class="nf-range" min="0" max="1" step="0.1" disabled="@(!canWrite)"
                                   aria-label="@T[InfernoCmsLocalizableStrings.Sitemap.Model.Priority]"
                                   value="@entry.Priority.ToString("0.0", CultureInfo.InvariantCulture)"
                                   @onchange="args => PriorityChangedAsync(entry, args)" />
                            <span class="nf-cell-number">@entry.Priority.ToString("0.0", CultureInfo.InvariantCulture)</span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </Table>
}

@page "/admin/messaging/templates"
@attribute [Authorize(Policy = CmsConstants.Policies.MessagingRead)]
@inherits AdminPage

<PageTitle>@T[InfernoCmsLocalizableStrings.Messaging.MessageTemplates]</PageTitle>

<PageHeader Title="@T[InfernoCmsLocalizableStrings.Messaging.MessageTemplates]" Icon="mail" Description="@T[InfernoCmsLocalizableStrings.Messaging.TemplatesDescription]">
    <Actions>
        <a class="nf-button" href="/admin/messaging/queued-emails"><Icon Name="inbox" Size="16" /> @T[InfernoCmsLocalizableStrings.Messaging.QueuedEmails]</a>
        @if (canWrite)
        {
            <button type="button" class="nf-button nf-button-primary" @onclick="Create">
                <Icon Name="plus" Size="16" /> @T[InfernoCmsLocalizableStrings.Messaging.NewTemplate]
            </button>
        }
    </Actions>
</PageHeader>

<div class="nf-toolbar">
    <SearchField Value="@search" ValueChanged="SearchChangedAsync" Placeholder="@T[InfernoWebLocalizableStrings.Admin.SearchPlaceholder]" />
</div>

@if (templates is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (templates.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(search))
    {
        <EmptyState Icon="mail" Title="@T[InfernoCmsLocalizableStrings.Messaging.EmptyTitle]" Description="@T[InfernoCmsLocalizableStrings.Messaging.EmptyDescription]">
            @if (canWrite)
            {
                <button type="button" class="nf-button nf-button-primary" @onclick="Create">
                    <Icon Name="plus" Size="16" /> @T[InfernoCmsLocalizableStrings.Messaging.NewTemplate]
                </button>
            }
        </EmptyState>
    }
    else
    {
        <EmptyState Icon="search" Title="@T[InfernoWebLocalizableStrings.Admin.NoMatchesTitle]" Description="@T[InfernoWebLocalizableStrings.Admin.NoMatchesDescription]" />
    }
}
else
{
    <Table>
        <thead>
            <tr>
                <th>@T[InfernoCmsLocalizableStrings.Messaging.Name]</th>
                <th>@T[InfernoCmsLocalizableStrings.Messaging.Subject]</th>
                <th>@T[InfernoCmsLocalizableStrings.Messaging.Enabled]</th>
                <th class="nf-cell-nowrap">@T[InfernoCmsLocalizableStrings.Pages.LastEdited]</th>
                <th class="nf-cell-actions"><span class="nf-sr-only">@T[InfernoWebLocalizableStrings.General.Actions]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var template in templates)
            {
                <tr @key="template.Id">
                    <td>
                        <a class="nf-row-title" href="@DesignUrl(template.Id)">@template.Name</a>
                    </td>
                    <td class="nf-muted nf-truncate">@template.Subject</td>
                    <td>
                        @if (template.Enabled)
                        {
                            <span class="nf-badge nf-badge-success">@T[InfernoWebLocalizableStrings.Admin.On]</span>
                        }
                        else
                        {
                            <span class="nf-badge nf-badge-muted">@T[InfernoWebLocalizableStrings.Admin.Off]</span>
                        }
                    </td>
                    <td class="nf-muted nf-cell-nowrap">@template.DateModifiedUtc?.ToLocalTime().ToString("g")</td>
                    <td class="nf-cell-actions">
                        <div class="nf-row-actions">
                            <a class="nf-icon-button" title="@T[InfernoCmsLocalizableStrings.Messaging.DesignMessage]" href="@DesignUrl(template.Id)">
                                <Icon Name="edit" Size="16" />
                            </a>
                            @if (canWrite)
                            {
                                <button type="button" class="nf-icon-button" title="@T[InfernoWebLocalizableStrings.General.Details]" @onclick="() => EditAsync(template)">
                                    <Icon Name="settings" Size="16" />
                                </button>
                                <button type="button" class="nf-icon-button nf-danger-hover" title="@T[InfernoWebLocalizableStrings.General.Delete]" @onclick="() => DeleteAsync(template)">
                                    <Icon Name="trash" Size="16" />
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </Table>
}

<Drawer Open="editing is not null" Scrim="true" Width="min(480px, 100vw)" OnClose="Close"
        Title="@(IsNew ? T[InfernoCmsLocalizableStrings.Messaging.NewTemplate].Value : T[InfernoWebLocalizableStrings.General.EditFormat, editing?.Name ?? string.Empty].Value)">
    <ChildContent>
        @if (editing is not null)
        {
            <EditForm id="message-template-form" Model="editing" OnValidSubmit="SaveAsync">
                <Field Label="@T[InfernoCmsLocalizableStrings.Messaging.Name]" For="template-name">
                    <InputText id="template-name" class="nf-input" @bind-Value="editing.Name" autofocus />
                    <ErrorText Errors="errors" Key="Name" />
                </Field>
                <Field Label="@T[InfernoCmsLocalizableStrings.Messaging.Subject]" For="template-subject">
                    <InputText id="template-subject" class="nf-input" @bind-Value="editing.Subject" />
                    <p class="nf-hint">@T[InfernoCmsLocalizableStrings.Messaging.TokensHint]</p>
                </Field>
                <Switch @bind-Value="editing.Enabled" Label="@T[InfernoCmsLocalizableStrings.Messaging.Enabled]" Description="@T[InfernoCmsLocalizableStrings.Messaging.EnabledHint]" />
                @if (IsNew)
                {
                    <p class="nf-hint">@T[InfernoCmsLocalizableStrings.Messaging.DesignAfterCreate]</p>
                }
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="Close">@T[InfernoWebLocalizableStrings.General.Cancel]</button>
        <button type="submit" form="message-template-form" class="nf-button nf-button-primary" disabled="@saving">
            <Icon Name="save" Size="16" /> @(IsNew ? T[InfernoCmsLocalizableStrings.Messaging.CreateAndDesign] : T[InfernoWebLocalizableStrings.General.Save])
        </button>
    </Footer>
</Drawer>

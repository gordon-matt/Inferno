@page "/admin/messaging/templates/{TemplateId:int}"
@attribute [Authorize(Policy = CmsConstants.Policies.MessagingRead)]

@* Messaging admin moved to Kourier. *@
@inject NavigationManager Navigation

@code {
    [Parameter]
    public int TemplateId { get; set; }

    protected override void OnInitialized() => Navigation.NavigateTo("/admin/email/templates", forceLoad: true);
}

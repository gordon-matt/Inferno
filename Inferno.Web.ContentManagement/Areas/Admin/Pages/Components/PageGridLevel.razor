@using Inferno.Web.ContentManagement.Areas.Admin.Pages.Entities

@* One level of the page tree. A page that has sub-pages expands into another PageGridLevel. *@
<RadzenDataGrid @ref="grid"
                TItem="Page"
                Data="rows"
                ShowPagingSummary="false"
                AllowPaging="false"
                AllowSorting="false"
                AllowFiltering="false"
                ExpandMode="DataGridExpandMode.Multiple"
                RowRender="OnRowRender"
                ShowHeader="@(ParentId is null)"
                Class="@(ParentId is null ? null : "mb-2")">
    <Template Context="row">
        <div class="ps-3 pb-2">
            <PageGridLevel Pages="Pages" Versions="Versions" ParentId="row.Id" OnEdit="OnEdit" OnAddSubPage="OnAddSubPage" OnDelete="OnDelete" />
        </div>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="Page" Title="@T[InfernoCmsLocalizableStrings.Pages.PageModel.Name]">
            <Template Context="row">
                <a href="#" class="fw-semibold text-decoration-none" @onclick:preventDefault @onclick="@(() => OnEdit.InvokeAsync(row))">@row.Name</a>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Page" Title="@T[InfernoCmsLocalizableStrings.Pages.Address]">
            <Template Context="row">
                @if (Versions.GetValueOrDefault(row.Id) is { } version)
                {
                    <span class="text-muted">/@version.Slug</span>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Page" Title="@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Status]" Width="130px">
            <Template Context="row">
                @if (!row.IsEnabled)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@T[InfernoCmsLocalizableStrings.Pages.SwitchedOff].Value" />
                }
                else if (Versions.GetValueOrDefault(row.Id)?.Status == VersionStatus.Published)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@T[InfernoCmsLocalizableStrings.Pages.Published].Value" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@T[InfernoCmsLocalizableStrings.Pages.Draft].Value" />
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Page" Title="@T[InfernoCmsLocalizableStrings.Pages.LastEdited]" Width="160px">
            <Template Context="row">
                @if (Versions.GetValueOrDefault(row.Id) is { } version)
                {
                    @version.DateModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Page" Context="row" TextAlign="TextAlign.Right" Width="230px">
            <Template Context="row">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="edit" Size="ButtonSize.Small" Text="@T[InfernoWebLocalizableStrings.General.Edit]" Click="@(() => OnEdit.InvokeAsync(row))" />
                <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="subdirectory_arrow_right" Size="ButtonSize.Small" Title="@T[InfernoCmsLocalizableStrings.Pages.AddSubPage]" Click="@(() => OnAddSubPage.InvokeAsync(row))" />
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Small" Title="@T[InfernoWebLocalizableStrings.General.Delete]" Click="@(() => OnDelete.InvokeAsync(row))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private RadzenDataGrid<Page> grid;
    private List<Page> rows = [];
    private bool expanded;

    /// <summary>Every page of the site. The level shows the ones under <see cref="ParentId"/>.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyCollection<Page> Pages { get; set; }

    /// <summary>The default-language version of each page, for the address, status and last edited columns.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<Guid, PageVersion> Versions { get; set; }

    /// <summary>The page whose sub-pages this level shows. Null is the top level.</summary>
    [Parameter]
    public Guid? ParentId { get; set; }

    [Parameter]
    public EventCallback<Page> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Page> OnAddSubPage { get; set; }

    [Parameter]
    public EventCallback<Page> OnDelete { get; set; }

    protected override void OnParametersSet() =>
        rows = PageHierarchy.ChildrenOf(Pages, ParentId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Show the whole tree to begin with. Editors can still collapse a branch.
        if (!expanded && grid is not null && rows.Count > 0)
        {
            expanded = true;
            var withSubPages = rows.Where(HasSubPages).ToList();
            if (withSubPages.Count > 0)
            {
                await grid.ExpandRows(withSubPages);
            }
        }
    }

    private void OnRowRender(RowRenderEventArgs<Page> args) =>
        args.Expandable = HasSubPages(args.Data);

    private bool HasSubPages(Page page) =>
        Pages.Any(candidate => candidate.ParentId == page.Id);
}

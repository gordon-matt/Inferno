@page "/admin/pages/index"
@attribute [Authorize(Policy = CmsConstants.Policies.PagesRead)]
@using Inferno.Web.ContentManagement.Areas.Admin.Pages.Components

<h1>@T[InfernoCmsLocalizableStrings.Pages.ManagePages]</h1>
<p class="text-muted">@T[InfernoCmsLocalizableStrings.Pages.PagesIntro]</p>

@if (showCreate)
{
    <div class="card mb-3">
        <div class="card-header">@CreateHeading</div>
        <div class="card-body">
            <p class="text-muted">@T[InfernoCmsLocalizableStrings.Pages.NewPageIntro]</p>
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">@T[InfernoCmsLocalizableStrings.Pages.PageModel.Name]</label>
                    <RadzenTextBox @bind-Value="newName" Style="width:100%" Name="NewName" />
                </div>
                <div class="col-md-4 text-end">
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Click="CancelCreate" Text="@T[InfernoWebLocalizableStrings.General.Cancel]" Disabled="creating" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="web" Click="CreateAsync" IsBusy="creating" Text="@T[InfernoCmsLocalizableStrings.Pages.CreateAndDesign]" />
                </div>
                @if (createError is not null)
                {
                    <div class="col-12">
                        <div class="text-danger">@createError</div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="mb-3">
        <RadzenButton Click="@(() => BeginCreate(null))" Icon="add" Text="@T[InfernoCmsLocalizableStrings.Pages.NewPage]" />
    </div>
}

@if (pages.Count > 0)
{
    @* Keyed on the loaded data, so the nested grids are rebuilt after a page is added, moved or deleted. *@
    <PageGridLevel @key="loadVersion" Pages="pages" Versions="currentVersions" ParentId="null" OnEdit="EditAsync" OnAddSubPage="BeginCreate" OnDelete="DeleteAsync" />
}

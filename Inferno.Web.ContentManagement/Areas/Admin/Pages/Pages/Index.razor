@page "/admin/pages/index"
@using Inferno.Web.ContentManagement.Areas.Admin.Pages.Entities
@inherits RadzenDataPage<Page, Guid>

<h1>@T[InfernoCmsLocalizableStrings.Pages.ManagePages]</h1>

<div class="row" hidden="@(ShowEditMode == true || ShowCreateMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
    </div>

    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="Page"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="10"
                        ColumnWidth="200px">
            <Columns>
                <RadzenDataGridColumn TItem="Page" Property="Name" Title="@T[InfernoCmsLocalizableStrings.Pages.PageModel.Name]" />
                <RadzenDataGridColumn TItem="Page" Property="PageTypeId" Title="@T[InfernoCmsLocalizableStrings.Pages.PageModel.PageTypeId]" Filterable="false" Sortable="false">
                    <Template Context="record">
                        @(GetPageTypeName(record.PageTypeId))
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Page" Property="Order" Title="@T[InfernoCmsLocalizableStrings.Pages.PageModel.Order]" Width="100px" />
                <RadzenDataGridColumn TItem="Page" Property="IsEnabled" Title="@T[InfernoCmsLocalizableStrings.Pages.PageModel.IsEnabled]" Width="120px" />
                <RadzenDataGridColumn TItem="Page" Property="ShowOnMenus" Title="@T[InfernoCmsLocalizableStrings.Pages.PageModel.ShowOnMenus]" Width="140px" />
                <RadzenDataGridColumn TItem="Page" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="180px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="history" Size="ButtonSize.Medium" Click="@(args => NavigateToVersions(record.Id))" @onclick:stopPropagation="true" Title="@T[InfernoCmsLocalizableStrings.Pages.History]"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(args => EditAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(args => DeleteAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="form-section" hidden="@(ShowEditMode == false && ShowCreateMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">@T[InfernoCmsLocalizableStrings.Pages.Page]</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.Pages.PageModel.PageTypeId]</label>
                                <div class="col-md-9">
                                    <RadzenDropDown @bind-Value="Model.PageTypeId"
                                                    Data="PageTypesSelectList"
                                                    TextProperty="Name"
                                                    ValueProperty="Id"
                                                    Style="width:100%"
                                                    Name="PageTypeId" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.Pages.PageModel.Name]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.Name" Style="width:100%" Name="Name" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3">@T[InfernoCmsLocalizableStrings.Pages.PageModel.Order]</label>
                                <div class="col-md-9">
                                    <RadzenNumeric @bind-Value="Model.Order" Style="width:100%" Name="Order" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3"></label>
                                <div class="col-md-9">
                                    <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.IsEnabled" />@T[InfernoCmsLocalizableStrings.Pages.PageModel.IsEnabled]</label></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3"></label>
                                <div class="col-md-9">
                                    <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.ShowOnMenus" />@T[InfernoCmsLocalizableStrings.Pages.PageModel.ShowOnMenus]</label></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@page "/admin/pages/versions/{PageId:guid}"
@using Inferno.Web.ContentManagement.Areas.Admin.Pages.Entities
@inherits RadzenDataPage<PageVersion, Guid>

<h1>@T[InfernoCmsLocalizableStrings.Pages.PageHistory] — @PageName</h1>

<div class="row" hidden="@(ShowEditMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="GoBack">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Back]
        </RadzenButton>
    </div>

    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="PageVersion"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="20"
                        ColumnWidth="180px">
            <Columns>
                <RadzenDataGridColumn TItem="PageVersion" Property="Title" Title="@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Title]" />
                <RadzenDataGridColumn TItem="PageVersion" Property="Slug" Title="@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Slug]" />
                <RadzenDataGridColumn TItem="PageVersion" Property="CultureCode" Title="@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.CultureCode]" Width="120px">
                    <Template Context="record">
                        @(string.IsNullOrEmpty(record.CultureCode) ? "—" : record.CultureCode)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PageVersion" Property="Status" Title="@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Status]" Width="120px" />
                <RadzenDataGridColumn TItem="PageVersion" Property="DateModifiedUtc" Title="@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.DateModified]" Width="180px">
                    <Template Context="record">
                        @record.DateModifiedUtc.ToString("yyyy-MM-dd HH:mm")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PageVersion" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="180px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(() => EditAsync(record.Id))" @onclick:stopPropagation="true" Title="@T[InfernoWebLocalizableStrings.General.Edit]"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="restore" Size="ButtonSize.Medium" Click="@(() => RestoreAsync(record))" @onclick:stopPropagation="true" Title="@T[InfernoCmsLocalizableStrings.Pages.RestoreVersion]" Disabled="@(record.Status == VersionStatus.Published)"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(() => DeleteAsync(record.Id))" @onclick:stopPropagation="true" Title="@T[InfernoWebLocalizableStrings.General.Delete]"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="form-section" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">@T[InfernoWebLocalizableStrings.General.Details]</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Title]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.Title" Style="width:100%" Name="Title" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Slug]</label>
                                <div class="col-md-8">
                                    <RadzenTextBox @bind-Value="Model.Slug" Style="width:100%" Name="Slug" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.CultureCode]</label>
                                <div class="col-md-8">
                                    <RadzenDropDown @bind-Value="Model.CultureCode"
                                                    Data="CultureSelectList"
                                                    TextProperty="Name"
                                                    ValueProperty="Value"
                                                    AllowClear="true"
                                                    Style="width:100%"
                                                    Name="CultureCode" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Status]</label>
                                <div class="col-md-8">
                                    <RadzenDropDown TValue="VersionStatus"
                                                    @bind-Value="Model.Status"
                                                    Data="StatusSelectList"
                                                    Style="width:100%"
                                                    Name="Status" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (IsStandardPage)
                    {
                        <hr />
                        <h5>@T[InfernoCmsLocalizableStrings.Pages.PageTypes.Title]: Standard Page</h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row mb-3">
                                    <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Pages.PageTypes.StandardPage.MetaTitle]</label>
                                    <div class="col-md-8">
                                        <RadzenTextBox @bind-Value="Fields.MetaTitle" Style="width:100%" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row mb-3">
                                    <label class="col-form-label col-md-4">@T[InfernoCmsLocalizableStrings.Pages.PageTypes.StandardPage.MetaKeywords]</label>
                                    <div class="col-md-8">
                                        <RadzenTextBox @bind-Value="Fields.MetaKeywords" Style="width:100%" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="row mb-3">
                                    <label class="col-form-label col-md-2">@T[InfernoCmsLocalizableStrings.Pages.PageTypes.StandardPage.MetaDescription]</label>
                                    <div class="col-md-10">
                                        <RadzenTextArea @bind-Value="Fields.MetaDescription" Rows="2" Style="width:100%" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="row mb-3">
                                    <label class="col-form-label col-md-2">@T[InfernoCmsLocalizableStrings.Pages.PageTypes.StandardPage.BodyContent]</label>
                                    <div class="col-md-10">
                                        <PickstackScripts />
                                        <PickstackEditor @bind-Value="Fields.BodyContent" FileRoot="@WorkContext.TenantRoot" Height="400" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <hr />
                        <div class="row">
                            <div class="col-12">
                                <div class="row mb-3">
                                    <label class="col-form-label col-md-2">Fields (JSON)</label>
                                    <div class="col-md-10">
                                        <RadzenTextArea @bind-Value="Model.Fields" Rows="12" Style="width:100%; font-family: monospace;" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <hr />

                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

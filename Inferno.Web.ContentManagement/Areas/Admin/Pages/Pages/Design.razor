@page "/admin/pages/design/{VersionId:guid}"
@using PageKrafter.Components

<HeadContent>
    <link rel="stylesheet" href="_content/PageKrafter.Components/pagekrafter.css" />
</HeadContent>

<PageTitle>@T[InfernoCmsLocalizableStrings.Pages.EditContent] — @Heading</PageTitle>

@if (!found)
{
    <p class="text-muted">@message</p>
    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="arrow_back" Text="@T[InfernoWebLocalizableStrings.General.Back]" Click="GoBack" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h1 class="h4 mb-0">
                @Heading
                @if (published)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@T[InfernoCmsLocalizableStrings.Pages.Published].Value" class="ms-2" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@T[InfernoCmsLocalizableStrings.Pages.Draft].Value" class="ms-2" />
                }
                @if (!string.IsNullOrEmpty(cultureCode))
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@cultureCode" class="ms-1" />
                }
            </h1>
            @if (savedAt is not null)
            {
                <span class="text-success">@savedAt</span>
            }
        </div>
        <div>
            @if (published)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Light" Text="@T[InfernoCmsLocalizableStrings.Pages.SwitchToDraft]" Click="@(() => SetPublishedAsync(false))" IsBusy="publishing" />
            }
            else
            {
                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="publish" Text="@T[InfernoCmsLocalizableStrings.Pages.Publish]" Click="@(() => SetPublishedAsync(true))" IsBusy="publishing" />
            }
            <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="settings" Text="@T[InfernoCmsLocalizableStrings.Pages.Page]" Click="GoBack" class="ms-2" />
        </div>
    </div>

    <PageKrafterEditor @bind-Value="documentJson" OnSave="SaveAsync" Height="calc(100vh - 180px)" />
}

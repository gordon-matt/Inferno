@page "/admin/pages/design/{VersionId:guid}"
@attribute [Authorize(Policy = CmsConstants.Policies.PagesRead)]
@inherits AdminPage
@using PageKrafter.Components

<HeadContent>
    <link rel="stylesheet" href="_content/PageKrafter.Components/pagekrafter.css" />
</HeadContent>

<PageTitle>@T[InfernoCmsLocalizableStrings.Pages.EditContent] — @Heading</PageTitle>

<nav class="nf-breadcrumbs" aria-label="Breadcrumb"><a href="/admin/pages/index">@T[InfernoCmsLocalizableStrings.Pages.Title]</a><span aria-hidden="true">/</span><span aria-current="page">@Heading</span></nav>

@if (!found)
{
    <EmptyState Icon="file-earmark-text" Title="@(message ?? T[InfernoWebLocalizableStrings.General.Loading].Value)">
        <a class="nf-button" href="/admin/pages/index"><Icon Name="arrow-left" Size="16" /> @T[InfernoWebLocalizableStrings.General.Back]</a>
    </EmptyState>
}
else
{
    <div class="inferno-design-bar">
        <div class="inferno-design-title">
            <h1>@Heading</h1>
            @if (published)
            {
                <span class="nf-badge nf-badge-success">@T[InfernoCmsLocalizableStrings.Pages.Published]</span>
            }
            else
            {
                <span class="nf-badge nf-badge-warning">@T[InfernoCmsLocalizableStrings.Pages.Draft]</span>
            }
            @if (!string.IsNullOrEmpty(cultureCode))
            {
                <span class="nf-badge nf-badge-info">@cultureCode</span>
            }
            @if (savedAt is not null)
            {
                <span class="nf-muted" role="status"><Icon Name="check" Size="14" /> @savedAt</span>
            }
        </div>
        <div class="inferno-design-actions">
            @if (cultures.Count > 1)
            {
                <select class="nf-select" aria-label="@T[InfernoCmsLocalizableStrings.Pages.Language]" value="@CultureValue" @onchange="args => ChangeCultureAsync(args.Value?.ToString())">
                    @foreach (var culture in cultures)
                    {
                        <option value="@culture.Value">@culture.Name</option>
                    }
                </select>
            }
            <a class="nf-button" href="/admin/pages/preview/@VersionId" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">
                <Icon Name="eye" Size="16" /> @T[InfernoCmsLocalizableStrings.Pages.Preview]
            </a>
            <button type="button" class="nf-button" @onclick="OpenHistoryAsync">
                <Icon Name="clock-history" Size="16" /> @T[InfernoCmsLocalizableStrings.Pages.History]
            </button>
            <button type="button" class="nf-button" @onclick="OpenDetails">
                <Icon Name="settings" Size="16" /> @T[InfernoWebLocalizableStrings.General.Details]
            </button>
            @if (published)
            {
                <button type="button" class="nf-button" disabled="@publishing" @onclick="() => SetPublishedAsync(false)">@T[InfernoCmsLocalizableStrings.Pages.SwitchToDraft]</button>
            }
            else
            {
                <button type="button" class="nf-button nf-button-primary" disabled="@publishing" @onclick="() => SetPublishedAsync(true)">
                    <Icon Name="send" Size="16" /> @T[InfernoCmsLocalizableStrings.Pages.Publish]
                </button>
            }
        </div>
    </div>

    <PickstackScripts />
    <PageKrafterEditor @key="editorKey" @bind-Value="documentJson" OnSave="SaveAsync" Height="calc(100vh - 210px)" />
}

<Drawer Open="showDetails" Scrim="true" Width="min(560px, 100vw)" OnClose="CloseDetails" Title="@T[InfernoWebLocalizableStrings.General.Details]">
    <ChildContent>
        @if (showDetails)
        {
            <EditForm id="page-details-form" Model="details" OnSubmit="SaveDetailsAsync">
                @if (detailsError is not null)
                {
                    <p class="nf-validation" role="alert">@detailsError</p>
                }

                <TabSet @bind-ActiveTab="detailsTab" KeepPanelsMounted="true">
                    <Tab Id="visitors" Title="@T[InfernoCmsLocalizableStrings.Pages.VisitorDetails]" Icon="eye">
                        <p class="nf-hint">@T[InfernoCmsLocalizableStrings.Pages.VisitorDetailsIntro]</p>
                        <Field Label="@T[InfernoCmsLocalizableStrings.Pages.PageVersionModel.Title]" For="details-title">
                            <InputText id="details-title" class="nf-input" @bind-Value="details.Title" />
                        </Field>
                        <Field Label="@T[InfernoCmsLocalizableStrings.Pages.Address]" For="details-slug">
                            <InputText id="details-slug" class="nf-input" @bind-Value="details.Slug" placeholder="about-us" />
                        </Field>
                    </Tab>
                    <Tab Id="search" Title="@T[InfernoCmsLocalizableStrings.Pages.SearchEngines]" Icon="search">
                        <Field Label="@T[InfernoCmsLocalizableStrings.Pages.MetaTitle]" For="details-meta-title">
                            <InputText id="details-meta-title" class="nf-input" @bind-Value="details.MetaTitle" />
                        </Field>
                        <Field Label="@T[InfernoCmsLocalizableStrings.Pages.MetaKeywords]" For="details-meta-keywords">
                            <InputText id="details-meta-keywords" class="nf-input" @bind-Value="details.MetaKeywords" />
                        </Field>
                        <Field Label="@T[InfernoCmsLocalizableStrings.Pages.MetaDescription]" For="details-meta-description">
                            <InputTextArea id="details-meta-description" class="nf-textarea" @bind-Value="details.MetaDescription" rows="4" />
                        </Field>
                    </Tab>
                    <Tab Id="page" Title="@T[InfernoCmsLocalizableStrings.Pages.Page]" Icon="sitemap">
                        <p class="nf-hint">@T[InfernoCmsLocalizableStrings.Pages.SettingsIntro]</p>
                        <Field Label="@T[InfernoCmsLocalizableStrings.Pages.PageModel.Name]" For="details-name">
                            <InputText id="details-name" class="nf-input" @bind-Value="pageEdit.Name" />
                        </Field>
                        <div class="nf-form-row">
                            <Field Label="@T[InfernoCmsLocalizableStrings.Pages.ParentPage]" For="details-parent">
                                <select id="details-parent" class="nf-select nf-select-block" @bind="ParentValue">
                                    <option value="">@T[InfernoCmsLocalizableStrings.Pages.TopLevel]</option>
                                    @foreach (var option in parentOptions)
                                    {
                                        <option value="@option.Page.Id">@(new string('\u00A0', option.Depth * 4))@option.Page.Name</option>
                                    }
                                </select>
                            </Field>
                            <Field Label="@T[InfernoCmsLocalizableStrings.Pages.PageModel.Order]" For="details-order">
                                <InputNumber id="details-order" class="nf-input" @bind-Value="pageEdit.Order" />
                            </Field>
                        </div>
                        <Switch @bind-Value="pageEdit.IsEnabled" Label="@T[InfernoCmsLocalizableStrings.Pages.PageModel.IsEnabled]" />
                        <Switch @bind-Value="pageEdit.ShowOnMenus" Label="@T[InfernoCmsLocalizableStrings.Pages.PageModel.ShowOnMenus]" />
                    </Tab>
                    @if (availableRoles.Count > 0)
                    {
                        <Tab Id="access" Title="@T[InfernoCmsLocalizableStrings.Pages.WhoCanSee]" Icon="shield-lock">
                            <fieldset class="nf-check-grid">
                                <legend>@T[InfernoCmsLocalizableStrings.Pages.WhoCanSeeHelp]</legend>
                                @foreach (var role in availableRoles)
                                {
                                    <label class="nf-check">
                                        <input type="checkbox" checked="@selectedRoleIds.Contains(role.Id)" @onchange="args => ToggleRole(role.Id, args.Value is true)" />
                                        <span>@role.Name</span>
                                    </label>
                                }
                            </fieldset>
                        </Tab>
                    }
                </TabSet>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="CloseDetails">@T[InfernoWebLocalizableStrings.General.Cancel]</button>
        <button type="submit" form="page-details-form" class="nf-button nf-button-primary" disabled="@savingDetails">
            <Icon Name="save" Size="16" /> @T[InfernoWebLocalizableStrings.General.Save]
        </button>
    </Footer>
</Drawer>

<Drawer Open="showHistory" Scrim="true" Width="min(480px, 100vw)" OnClose="CloseHistory" Title="@T[InfernoCmsLocalizableStrings.Pages.History]">
    <p class="nf-hint">@T[InfernoCmsLocalizableStrings.Pages.HistoryIntro]</p>
    @if (history.Count == 0)
    {
        <EmptyState Icon="clock-history" Title="@T[InfernoCmsLocalizableStrings.Pages.HistoryEmpty]" />
    }
    else
    {
        <ol class="inferno-history">
            @foreach (var saved in history)
            {
                <li @key="saved.Id">
                    <div class="inferno-history-body">
                        <strong>@saved.DateModifiedUtc.ToLocalTime().ToString("g")</strong>
                        <span class="nf-muted nf-truncate">@saved.Title · /@saved.Slug</span>
                    </div>
                    <div class="nf-row-actions">
                        <a class="nf-icon-button" title="@T[InfernoCmsLocalizableStrings.Pages.Preview]" href="/admin/pages/preview/@saved.Id" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">
                            <Icon Name="eye" Size="16" />
                        </a>
                        <button type="button" class="nf-button nf-button-sm" disabled="@restoring" @onclick="() => RestoreAsync(saved)">
                            <Icon Name="refresh" Size="14" /> @T[InfernoCmsLocalizableStrings.Pages.Restore]
                        </button>
                    </div>
                </li>
            }
        </ol>
    }
</Drawer>

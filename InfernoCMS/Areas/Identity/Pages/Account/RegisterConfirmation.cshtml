@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

<h1>@ViewData["Title"]</h1>
@if (Model.DisplayConfirmAccountLink)
{
    <p class="nf-hint">
        No email sender is configured, so the confirmation link is shown here.
        <a id="confirm-link" href="@Model.EmailConfirmationUrl">Confirm this account</a>
    </p>
}
else
{
    <p class="nf-hint">Check your email to confirm the account.</p>
}

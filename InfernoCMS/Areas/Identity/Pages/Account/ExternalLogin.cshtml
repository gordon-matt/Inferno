@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Create account";
}

<h1>@ViewData["Title"]</h1>
<p class="nf-hint">
    Signed in with <strong>@Model.ProviderDisplayName</strong>.
    Enter an email for this site to finish.
</p>

<form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="nf-input" autocomplete="email" autofocus />
        <span asp-validation-for="Input.Email" class="nf-validation"></span>
    </div>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Create account</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

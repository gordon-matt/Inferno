@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
}

<h1>@ViewData["Title"]</h1>
<p class="nf-hint">This sign-in is not remembered until you next use an authenticator code, or turn two-factor authentication off.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Input.RecoveryCode"></label>
        <input asp-for="Input.RecoveryCode" class="nf-input" autocomplete="off" autofocus />
        <span asp-validation-for="Input.RecoveryCode" class="nf-validation"></span>
    </div>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Sign in</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

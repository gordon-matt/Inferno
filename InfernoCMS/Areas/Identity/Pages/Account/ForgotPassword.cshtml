@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<h1>@ViewData["Title"]</h1>
<p class="nf-hint">Enter the email address on the account. A reset link will be sent there.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="nf-input" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="nf-validation"></span>
    </div>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Send reset link</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

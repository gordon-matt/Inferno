@page
@model InfernoCMS.Areas.Identity.Pages.Account.LoginModel
@inject Inferno.Web.Configuration.SiteSettings SiteSettings
@{
    ViewData["Title"] = "Sign in";
}

<h1>@ViewData["Title"]</h1>
<p class="nf-hint">Use the administrator account, or one an administrator created for you.</p>

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>

    <div class="nf-field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="nf-input" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="nf-validation"></span>
    </div>

    <div class="nf-field">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" class="nf-input" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="nf-validation"></span>
    </div>

    <label class="nf-check">
        <input asp-for="Input.RememberMe" />
        <span>Remember me</span>
    </label>

    <button id="login-submit" type="submit" class="nf-button nf-button-primary nf-button-block">Sign in</button>
</form>

<p class="nf-hint">
    <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
</p>
@if (SiteSettings.AllowRegistration)
{
    <p class="nf-hint">
        No account yet? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
    </p>
}

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        @foreach (var provider in Model.ExternalLogins!)
        {
            <button type="submit" class="nf-button nf-button-block" name="provider" value="@provider.Name" title="Sign in using your @provider.DisplayName account">@provider.DisplayName</button>
        }
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

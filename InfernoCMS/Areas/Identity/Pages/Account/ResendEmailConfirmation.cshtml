@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
}

<h1>@ViewData["Title"]</h1>
<p class="nf-hint">Enter your email and the confirmation message will be sent again.</p>

<form method="post">
    <div asp-validation-summary="All" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="nf-input" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="nf-validation"></span>
    </div>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Resend</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

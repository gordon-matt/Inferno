@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<h1>@ViewData["Title"]</h1>
<p class="nf-hint">Enter the code from your authenticator app.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <input asp-for="RememberMe" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Input.TwoFactorCode"></label>
        <input asp-for="Input.TwoFactorCode" class="nf-input" autocomplete="one-time-code" autofocus />
        <span asp-validation-for="Input.TwoFactorCode" class="nf-validation"></span>
    </div>
    <label class="nf-check">
        <input asp-for="Input.RememberMachine" />
        <span>@Html.DisplayNameFor(m => m.Input.RememberMachine)</span>
    </label>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Sign in</button>
</form>
<p class="nf-hint">
    No authenticator device?
    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Use a recovery code</a>.
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

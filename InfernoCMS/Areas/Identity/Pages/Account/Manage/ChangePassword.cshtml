@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Input.OldPassword"></label>
        <input asp-for="Input.OldPassword" class="nf-input" autocomplete="current-password" aria-required="true" />
        <span asp-validation-for="Input.OldPassword" class="nf-validation"></span>
    </div>
    <div class="nf-field">
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" class="nf-input" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.NewPassword" class="nf-validation"></span>
    </div>
    <div class="nf-field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" class="nf-input" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.ConfirmPassword" class="nf-validation"></span>
    </div>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>Set your password</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="nf-hint">You do not have a local username and password for this site. Add one so you can sign in without an external login.</p>
<form id="set-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" class="nf-input" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="nf-validation"></span>
    </div>
    <div class="nf-field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" class="nf-input" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="nf-validation"></span>
    </div>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Set password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

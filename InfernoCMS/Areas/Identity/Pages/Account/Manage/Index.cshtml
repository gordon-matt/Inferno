@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="profile-form" method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <div class="nf-field">
        <label asp-for="Username"></label>
        <input asp-for="Username" class="nf-input" disabled />
    </div>
    <div class="nf-field">
        <label asp-for="Input.PhoneNumber"></label>
        <input asp-for="Input.PhoneNumber" class="nf-input" />
        <span asp-validation-for="Input.PhoneNumber" class="nf-validation"></span>
    </div>
    <button id="update-profile-button" type="submit" class="nf-button nf-button-primary nf-button-block">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

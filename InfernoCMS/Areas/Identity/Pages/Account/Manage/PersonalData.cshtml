@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>
<p>Your account contains personal data that you have given us. This page lets you download or delete that data.</p>
<p><strong>Deleting this data permanently removes your account, and this cannot be recovered.</strong></p>
<div class="nf-actions">
    <form id="download-data" asp-page="DownloadPersonalData" method="post">
        <button class="nf-button nf-button-primary" type="submit">Download</button>
    </form>
    <a id="delete" asp-page="DeletePersonalData" class="nf-button nf-button-danger">Delete</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

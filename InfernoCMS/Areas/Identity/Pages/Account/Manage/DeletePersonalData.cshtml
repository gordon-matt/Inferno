@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>
<div class="nf-callout nf-callout-danger" role="alert">
    <p><strong>Deleting this data permanently removes your account, and this cannot be recovered.</strong></p>
</div>
<form id="delete-user" method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    @if (Model.RequirePassword)
    {
        <div class="nf-field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" class="nf-input" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="nf-validation"></span>
        </div>
    }
    <button class="nf-button nf-button-danger-solid nf-button-block" type="submit">Delete data and close my account</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="nf-validation" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />
    <div class="nf-field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" class="nf-input" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="nf-validation"></span>
    </div>
    <div class="nf-field">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" class="nf-input" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="nf-validation"></span>
    </div>
    <div class="nf-field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" class="nf-input" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="nf-validation"></span>
    </div>
    <button type="submit" class="nf-button nf-button-primary nf-button-block">Reset password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

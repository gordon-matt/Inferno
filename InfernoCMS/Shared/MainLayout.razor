@inherits LayoutComponentBase

<PageTitle>InfernoCMS</PageTitle>

<RadzenDialog />
<RadzenNotification />
<RadzenContextMenu />
<RadzenTooltip />

<div class="inferno-shell d-flex flex-column min-vh-100">
    <header class="inferno-shell-header fixed-top">
        <NavMenu />
    </header>
    <main class="inferno-shell-content flex-grow-1 px-4" style="margin-top:70px">
        @Body
    </main>
    <AuthorizeView>
        <Authorized>
            <div class="inferno-shell-footer mt-auto">
                <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top">
                    <p class="col-md-4 mb-0 text-muted">&copy; @DateTime.Now.Year</p>

                    <a href="/" class="col-md-4 d-flex align-items-center justify-content-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                        <img src="img/logo.png" alt="Inferno CMS" width="100" />
                    </a>

                    <ul class="nav col-md-4 justify-content-end">
                        <li class="nav-item"><a href="/admin/index" class="nav-link px-2 text-muted">@T[InfernoWebLocalizableStrings.Dashboard.Administration]</a></li>
                    </ul>
                </footer>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
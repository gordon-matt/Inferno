{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Pickstack": {
    "Storage": {
      "RequestPath": "/Media/Uploads/",
      "WebRootFolder": "Media/Uploads",
      "ThumbnailRequestPath": "/Media/Thumbs/",
      "ThumbnailWebRootFolder": "Media/Thumbs"
    }
  },
  "Kameleon": {
    "ThemesPath": "Themes",
    "FallbackThemeId": "default",
    "DefaultThemeId": "default",
    "EnabledThemes": [ "default" ],
    "AllowUserOverride": false
  },
  "Pluginz": {
    "PluginsPath": "Plugins",
    "DataPath": "App_Data/Pluginz",
    "ShadowCopy": true,
    "RequireAuthentication": true,
    "ReadPolicy": "Inferno.Plugins.Read",
    "ManagePolicy": "Inferno.Plugins.Manage",
    "NuGet": {
      "TagFilter": "inferno-cms",
      "Sources": [
        { "Name": "nuget.org", "Url": "https://api.nuget.org/v3/index.json" }
      ]
    }
  }
}

    <ProjectReference Include="..\InfernoCMS.Identity\InfernoCMS.Identity.csproj" />
    <ProjectReference Include="..\InfernoCMS.Services\InfernoCMS.Services.csproj" />
    <ProjectReference Include="..\Inferno\Inferno.csproj" />

@model InfernoCMS.Models.InstallationModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Installation Page";
}

<form method="post" action="/installation">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, string.Empty, new { @class = "text-danger mb-3" })

    <div class="card mb-3">
        <div class="card-header">Admin Login Details</div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(m => m.AdminEmail, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                    @Html.TextBoxFor(m => m.AdminEmail, new { @class = "form-control" })
                </div>
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.AdminPassword, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-key"></i></span>
                    @Html.PasswordFor(m => m.AdminPassword, new { @class = "form-control" })
                </div>
                <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</div>
            </div>
            <div class="mb-0">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-key"></i></span>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Database</div>
        <div class="card-body">
            <div class="mb-3">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.EnterConnectionString, new { @class = "form-check-input", onclick = "onEnterConnectionStringClick(this);" })
                    @Html.LabelFor(m => m.EnterConnectionString, new { @class = "form-check-label" })
                </div>
            </div>
            <div id="connection-string-group" class="mb-3" style="display:@(Model.EnterConnectionString ? "block" : "none")">
                @Html.LabelFor(m => m.ConnectionString, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-plug"></i></span>
                    @Html.TextBoxFor(m => m.ConnectionString, new { @class = "form-control" })
                </div>
            </div>
            <div id="database-server-group" class="mb-3" style="display:@(Model.EnterConnectionString ? "none" : "block")">
                @Html.LabelFor(m => m.DatabaseServer, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-database"></i></span>
                    @Html.TextBoxFor(m => m.DatabaseServer, new { @class = "form-control" })
                </div>
            </div>
            <div id="database-name-group" class="mb-3" style="display:@(Model.EnterConnectionString ? "none" : "block")">
                @Html.LabelFor(m => m.DatabaseName, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-database"></i></span>
                    @Html.TextBoxFor(m => m.DatabaseName, new { @class = "form-control" })
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.UseWindowsAuthentication, new { @class = "form-check-input", onclick = "onUseWindowsAuthenticationClick(this);" })
                    @Html.LabelFor(m => m.UseWindowsAuthentication, new { @class = "form-check-label" })
                </div>
            </div>
            <div id="database-username-group" class="mb-3" style="display:@(Model.UseWindowsAuthentication ? "none" : "block")">
                @Html.LabelFor(m => m.DatabaseUsername, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-user"></i></span>
                    @Html.TextBoxFor(m => m.DatabaseUsername, new { @class = "form-control" })
                </div>
            </div>
            <div id="database-password-group" class="mb-3" style="display:@(Model.UseWindowsAuthentication ? "none" : "block")">
                @Html.LabelFor(m => m.DatabasePassword, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-key"></i></span>
                    @Html.TextBoxFor(m => m.DatabasePassword, new { @class = "form-control" })
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.CreateSampleData, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.CreateSampleData, new { @class = "form-check-label" })
                </div>
                <div class="form-text">Adds a home page, a few pages (including a sub-page), a blog post and a menu, so there is something to look at.</div>
            </div>
            <input type="submit" class="btn btn-secondary" value="Install Now" />
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function onEnterConnectionStringClick(cb) {
            document.getElementById("connection-string-group").style.display = cb.checked ? "block" : "none";
            document.getElementById("database-server-group").style.display = cb.checked ? "none" : "block";
            document.getElementById("database-name-group").style.display = cb.checked ? "none" : "block";
        }

        function onUseWindowsAuthenticationClick(cb) {
            document.getElementById("database-username-group").style.display = cb.checked ? "none" : "block";
            document.getElementById("database-password-group").style.display = cb.checked ? "none" : "block";
        }
    </script>
}

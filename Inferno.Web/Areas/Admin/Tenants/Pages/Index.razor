@page "/admin/tenants/index"
@inherits RadzenDataPage<Tenant, int>

<h1>Tenants</h1>

<div class="row" hidden="@(ShowEditMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
        <RadzenButton Text="Excel" Click="@(args => Export("excel"))">
            Export to Excel
        </RadzenButton>
        <RadzenButton Text="CSV" Click="@(args => Export("csv"))">
            Export to CSV
        </RadzenButton>
    </div>

    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="Tenant"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="10"
                        ColumnWidth="200px">
            <Columns>
                <RadzenDataGridColumn TItem="Tenant" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="Tenant" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="50px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(args => EditAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(args => DeleteAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="form-section" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">Details</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Name">@T[InfernoWebLocalizableStrings.General.Name]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.Name" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Url">@T[InfernoWebLocalizableStrings.Tenants.Model.Url]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.Url" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Hosts">@T[InfernoWebLocalizableStrings.Tenants.Model.Hosts]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.Hosts" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
@page "/admin/tenants/index"
@attribute [Authorize(Policy = StandardPolicies.FullAccess)]
@inherits AdminPage

<PageTitle>@T[InfernoWebLocalizableStrings.Tenants.Title]</PageTitle>

<PageHeader Title="@T[InfernoWebLocalizableStrings.Tenants.Title]" Icon="globe" Description="@T[InfernoWebLocalizableStrings.Tenants.Description]">
    <Actions>
        <ActionMenu Label="@T[InfernoWebLocalizableStrings.General.Export]" TriggerClass="nf-button">
            <Trigger><Icon Name="download" Size="16" /> @T[InfernoWebLocalizableStrings.General.Export]</Trigger>
            <ChildContent>
                <ActionMenuItem Icon="file-earmark-text" Text="@T[InfernoWebLocalizableStrings.Tenants.ExportCsv]" Href="@ExportUrl("csv")" download="" />
                <ActionMenuItem Icon="grid" Text="@T[InfernoWebLocalizableStrings.Tenants.ExportExcel]" Href="@ExportUrl("excel")" download="" />
            </ChildContent>
        </ActionMenu>
        <button type="button" class="nf-button nf-button-primary" @onclick="Create">
            <Icon Name="plus" Size="16" /> @T[InfernoWebLocalizableStrings.Tenants.NewTenant]
        </button>
    </Actions>
</PageHeader>

<div class="nf-toolbar">
    <SearchField Value="@search" ValueChanged="SearchChangedAsync" Placeholder="@T[InfernoWebLocalizableStrings.Admin.SearchPlaceholder]" />
</div>

@if (listing is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (listing.TotalCount == 0)
{
    @if (string.IsNullOrWhiteSpace(search))
    {
        <EmptyState Icon="globe" Title="@T[InfernoWebLocalizableStrings.Tenants.EmptyTitle]">
            <button type="button" class="nf-button nf-button-primary" @onclick="Create">
                <Icon Name="plus" Size="16" /> @T[InfernoWebLocalizableStrings.Tenants.NewTenant]
            </button>
        </EmptyState>
    }
    else
    {
        <EmptyState Icon="search" Title="@T[InfernoWebLocalizableStrings.Admin.NoMatchesTitle]" Description="@T[InfernoWebLocalizableStrings.Admin.NoMatchesDescription]" />
    }
}
else
{
    <Table>
        <thead>
            <tr>
                <SortHeader Field="Name" Sort="sort" SortChanged="SortChangedAsync">@T[InfernoWebLocalizableStrings.General.Name]</SortHeader>
                <SortHeader Field="Url" Sort="sort" SortChanged="SortChangedAsync">@T[InfernoWebLocalizableStrings.Tenants.Model.Url]</SortHeader>
                <th>@T[InfernoWebLocalizableStrings.Tenants.Model.Hosts]</th>
                <th>@T[InfernoWebLocalizableStrings.Tenants.Model.SslEnabled]</th>
                <th class="nf-cell-actions"><span class="nf-sr-only">@T[InfernoWebLocalizableStrings.General.Actions]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in listing.Items)
            {
                <tr @key="tenant.Id">
                    <td>
                        <button type="button" class="nf-link-button nf-row-title" @onclick="() => Edit(tenant)">@tenant.Name</button>
                        @if (tenant.Id == TenantId)
                        {
                            <span class="nf-badge nf-badge-accent">@T[InfernoWebLocalizableStrings.Themes.Current]</span>
                        }
                    </td>
                    <td class="nf-muted">@tenant.Url</td>
                    <td class="nf-muted nf-truncate">@tenant.Hosts</td>
                    <td>
                        @if (tenant.SslEnabled)
                        {
                            <span class="nf-badge nf-badge-success">@T[InfernoWebLocalizableStrings.Admin.On]</span>
                        }
                        else
                        {
                            <span class="nf-badge nf-badge-muted">@T[InfernoWebLocalizableStrings.Admin.Off]</span>
                        }
                    </td>
                    <td class="nf-cell-actions">
                        <div class="nf-row-actions">
                            <button type="button" class="nf-icon-button" title="@T[InfernoWebLocalizableStrings.General.Edit]" @onclick="() => Edit(tenant)">
                                <Icon Name="edit" Size="16" />
                            </button>
                            <button type="button" class="nf-icon-button nf-danger-hover" title="@T[InfernoWebLocalizableStrings.General.Delete]" disabled="@(tenant.Id == TenantId)" @onclick="() => DeleteAsync(tenant)">
                                <Icon Name="trash" Size="16" />
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </Table>

    <Pager PageNumber="pageNumber" PageSize="pageSize" TotalCount="listing.TotalCount" PageNumberChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
}

<Drawer Open="editing is not null" Scrim="true" Width="min(480px, 100vw)" OnClose="Close"
        Title="@(editing?.Id == 0 ? T[InfernoWebLocalizableStrings.Tenants.NewTenant].Value : T[InfernoWebLocalizableStrings.General.EditFormat, editing?.Name ?? string.Empty].Value)">
    <ChildContent>
        @if (editing is not null)
        {
            <EditForm id="tenant-form" Model="editing" OnValidSubmit="SaveAsync">
                <Field Label="@T[InfernoWebLocalizableStrings.General.Name]" For="tenant-name">
                    <InputText id="tenant-name" class="nf-input" @bind-Value="editing.Name" autofocus />
                    <ErrorText Errors="errors" Key="Name" />
                </Field>
                <Field Label="@T[InfernoWebLocalizableStrings.Tenants.Model.Url]" For="tenant-url">
                    <InputText id="tenant-url" class="nf-input" @bind-Value="editing.Url" placeholder="http://example.com" />
                    <ErrorText Errors="errors" Key="Url" />
                </Field>
                <Field Label="@T[InfernoWebLocalizableStrings.Tenants.Model.Hosts]" For="tenant-hosts">
                    <InputText id="tenant-hosts" class="nf-input" @bind-Value="editing.Hosts" placeholder="example.com, www.example.com" />
                    <span class="nf-hint">@T[InfernoWebLocalizableStrings.Tenants.HostsHint]</span>
                </Field>
                <Switch @bind-Value="editing.SslEnabled" Label="@T[InfernoWebLocalizableStrings.Tenants.Model.SslEnabled]" />
                @if (editing.SslEnabled)
                {
                    <Field Label="@T[InfernoWebLocalizableStrings.Tenants.Model.SecureUrl]" For="tenant-secure-url">
                        <InputText id="tenant-secure-url" class="nf-input" @bind-Value="editing.SecureUrl" placeholder="https://example.com" />
                    </Field>
                }
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="Close">@T[InfernoWebLocalizableStrings.General.Cancel]</button>
        <button type="submit" form="tenant-form" class="nf-button nf-button-primary" disabled="@saving">
            <Icon Name="save" Size="16" /> @T[InfernoWebLocalizableStrings.General.Save]
        </button>
    </Footer>
</Drawer>

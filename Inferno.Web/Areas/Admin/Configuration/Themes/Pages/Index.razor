@page "/admin/configuration/themes/index"
@attribute [Authorize(Policy = InfernoWebPolicies.ThemesRead)]
@inherits AdminPage

<PageTitle>@T[InfernoWebLocalizableStrings.General.Themes]</PageTitle>

<PageHeader Title="@T[InfernoWebLocalizableStrings.General.Themes]" Icon="palette" Description="@T[InfernoWebLocalizableStrings.Themes.Description]" />

@if (themes is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (themes.Count == 0)
{
    <EmptyState Icon="palette" Title="@T[InfernoWebLocalizableStrings.Themes.EmptyTitle]" />
}
else
{
    <div class="nf-grid inferno-theme-grid">
        @foreach (var theme in themes)
        {
            <article class="nf-card inferno-theme-card @(theme.IsDefault ? "is-current" : null)" @key="theme.Name">
                <div class="inferno-theme-preview">
                    @if (!string.IsNullOrEmpty(theme.PreviewImageUrl) && !brokenPreviews.Contains(theme.Name))
                    {
                        <img src="@theme.PreviewImageUrl" alt="@theme.Title" loading="lazy" @onerror="() => brokenPreviews.Add(theme.Name)" />
                    }
                    else
                    {
                        <Icon Name="palette" Size="40" />
                    }
                </div>
                <h2 class="nf-card-title">
                    @theme.Title
                    @if (theme.IsDefault)
                    {
                        <span class="nf-badge nf-badge-success">@T[InfernoWebLocalizableStrings.Themes.Current]</span>
                    }
                </h2>
                <p>@theme.PreviewText</p>
                <div class="nf-card-meta">
                    <span>
                        @if (theme.SupportRtl)
                        {
                            <span class="nf-badge nf-badge-muted">@T[InfernoWebLocalizableStrings.Themes.Model.SupportRtl]</span>
                        }
                    </span>
                    @if (canWrite && !theme.IsDefault)
                    {
                        <button type="button" class="nf-button nf-button-sm" disabled="@busy" @onclick="() => SetDefaultAsync(theme)">
                            <Icon Name="check" Size="14" /> @T[InfernoWebLocalizableStrings.General.SetDefault]
                        </button>
                    }
                </div>
            </article>
        }
    </div>
}

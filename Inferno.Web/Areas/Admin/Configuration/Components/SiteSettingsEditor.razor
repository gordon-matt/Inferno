@using Inferno.Web.Configuration
@inherits SettingsEditor<SiteSettings>

<TabSet KeepPanelsMounted="true" AriaLabel="@Data?.Name">
    <Tab Id="general" Title="@T[InfernoWebLocalizableStrings.Settings.Site.Tabs.General]">
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Site.SiteName]" For="site-name">
            <input id="site-name" class="nf-input" @bind="Model.SiteName" />
        </Field>
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Site.DefaultGridPageSize]" For="site-page-size">
            <input id="site-page-size" class="nf-input" type="number" min="1" @bind="Model.DefaultGridPageSize" />
        </Field>
        <Switch @bind-Value="Model.EnableBlog" Label="@T[InfernoWebLocalizableStrings.Settings.Site.EnableBlog]" />
        <Switch @bind-Value="Model.AllowRegistration" Label="@T[InfernoWebLocalizableStrings.Settings.Site.AllowRegistration]" />
    </Tab>
    <Tab Id="localization" Title="@T[InfernoWebLocalizableStrings.Settings.Site.Tabs.Localization]">
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Site.DefaultLanguage]" For="site-language">
            <input id="site-language" class="nf-input" @bind="Model.DefaultLanguage" placeholder="en-US" />
        </Field>
    </Tab>
    <Tab Id="seo" Title="@T[InfernoWebLocalizableStrings.Settings.Site.Tabs.SEO]">
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Site.HomePageTitle]" For="site-home-title">
            <input id="site-home-title" class="nf-input" @bind="Model.HomePageTitle" />
        </Field>
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Site.DefaultMetaKeywords]" For="site-keywords">
            <input id="site-keywords" class="nf-input" @bind="Model.DefaultMetaKeywords" />
        </Field>
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Site.DefaultMetaDescription]" For="site-description">
            <textarea id="site-description" class="nf-textarea" rows="4" @bind="Model.DefaultMetaDescription"></textarea>
        </Field>
    </Tab>
</TabSet>

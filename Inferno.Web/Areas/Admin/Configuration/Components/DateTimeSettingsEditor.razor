@using Inferno.Web.Configuration
@inherits SettingsEditor<DateTimeSettings>

<Field Label="@T[InfernoWebLocalizableStrings.Settings.DateTime.DefaultTimeZoneId]" For="datetime-zone">
    <select id="datetime-zone" class="nf-select nf-select-block" @bind="Model.DefaultTimeZoneId">
        <option value="">@T[InfernoWebLocalizableStrings.General.SelectOption]</option>
        @foreach (var zone in TimeZoneInfo.GetSystemTimeZones())
        {
            <option value="@zone.Id">@zone.DisplayName</option>
        }
    </select>
</Field>
<Switch @bind-Value="Model.AllowUsersToSetTimeZone" Label="@T[InfernoWebLocalizableStrings.Settings.DateTime.AllowUsersToSetTimeZone]" />

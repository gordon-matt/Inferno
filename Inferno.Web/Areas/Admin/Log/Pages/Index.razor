@page "/admin/log/index"
@inherits RadzenDataPage<LogEntry, int>

<h1>@T[InfernoWebLocalizableStrings.Log.Title]</h1>

<Row hidden="@(ShowEditMode == true)">
    <Column ColumnSize="ColumnSize.Is12" Class="mb-3">
        <RadzenButton ButtonStyle="ButtonStyle.Warning" Icon="warning" Text="@T[InfernoWebLocalizableStrings.General.Clear]" Click="@(args => ClearAsync())" />
    </Column>

    <Column ColumnSize="ColumnSize.Is12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="LogEntry"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="20"
                        ColumnWidth="150px">
            <Columns>
                <RadzenDataGridColumn TItem="LogEntry" Property="EventDateTime" Title="@T[InfernoWebLocalizableStrings.Log.Model.EventDateTime]" FormatString="{0:yyyy-MM-dd HH:mm:ss}" Width="180px" />
                <RadzenDataGridColumn TItem="LogEntry" Property="EventLevel" Title="@T[InfernoWebLocalizableStrings.Log.Model.EventLevel]" Width="100px" />
                <RadzenDataGridColumn TItem="LogEntry" Property="UserName" Title="@T[InfernoWebLocalizableStrings.Log.Model.UserName]" Width="150px" />
                <RadzenDataGridColumn TItem="LogEntry" Property="MachineName" Title="@T[InfernoWebLocalizableStrings.Log.Model.MachineName]" Width="150px" />
                <RadzenDataGridColumn TItem="LogEntry" Property="EventMessage" Title="@T[InfernoWebLocalizableStrings.Log.Model.EventMessage]" />
                <RadzenDataGridColumn TItem="LogEntry" Property="ErrorSource" Title="@T[InfernoWebLocalizableStrings.Log.Model.ErrorSource]" Width="180px" />
                <RadzenDataGridColumn TItem="LogEntry" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="120px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="visibility" Size="ButtonSize.Medium" Click="@(args => EditAsync(record.Id))" @onclick:stopPropagation="true" />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(args => DeleteAsync(record.Id))" @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </Column>
</Row>

<Row id="form-section" hidden="@(ShowEditMode == false)">
    <Column ColumnSize="ColumnSize.Is12">
        <Card>
            <CardHeader Class="text-white bg-primary">@T[InfernoWebLocalizableStrings.General.Details]</CardHeader>
            <CardBody>
                <Row>
                    <Column ColumnSize="ColumnSize.Is4">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.EventDateTime]</FieldLabel>
                            <p class="form-control-plaintext">@Model.EventDateTime.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is4">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.EventLevel]</FieldLabel>
                            <p class="form-control-plaintext">@Model.EventLevel</p>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is4">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.UserName]</FieldLabel>
                            <p class="form-control-plaintext">@Model.UserName</p>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is4">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.MachineName]</FieldLabel>
                            <p class="form-control-plaintext">@Model.MachineName</p>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is4">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.ErrorSource]</FieldLabel>
                            <p class="form-control-plaintext">@Model.ErrorSource</p>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is4">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.ErrorClass]</FieldLabel>
                            <p class="form-control-plaintext">@Model.ErrorClass</p>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.ErrorMethod]</FieldLabel>
                            <p class="form-control-plaintext">@Model.ErrorMethod</p>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.EventMessage]</FieldLabel>
                            <pre class="bg-light p-3 rounded border" style="white-space:pre-wrap;word-break:break-word;">@Model.EventMessage</pre>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.ErrorMessage]</FieldLabel>
                            <pre class="bg-light p-3 rounded border" style="white-space:pre-wrap;word-break:break-word;">@Model.ErrorMessage</pre>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Field>
                            <FieldLabel>@T[InfernoWebLocalizableStrings.Log.Model.InnerErrorMessage]</FieldLabel>
                            <pre class="bg-light p-3 rounded border" style="white-space:pre-wrap;word-break:break-word;">@Model.InnerErrorMessage</pre>
                        </Field>
                    </Column>
                </Row>
                <hr />
                <Row>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Field Class="float-end">
                            <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                @T[InfernoWebLocalizableStrings.General.Cancel]
                            </RadzenButton>
                        </Field>
                    </Column>
                </Row>
            </CardBody>
        </Card>
    </Column>
</Row>

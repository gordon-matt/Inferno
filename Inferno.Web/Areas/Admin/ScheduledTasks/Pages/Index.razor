@page "/admin/scheduled-tasks/index"
@attribute [Authorize(Policy = InfernoWebPolicies.ScheduledTasksRead)]
@inherits AdminPage

<PageTitle>@T[InfernoWebLocalizableStrings.ScheduledTasks.Title]</PageTitle>

<PageHeader Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Title]" Icon="clock" Description="@T[InfernoWebLocalizableStrings.ScheduledTasks.Description]" />

@if (tasks is null)
{
    <p class="nf-muted">@T[InfernoWebLocalizableStrings.General.Loading]</p>
}
else if (tasks.Count == 0)
{
    <EmptyState Icon="clock" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.EmptyTitle]" />
}
else
{
    <div class="nf-toolbar">
        <SearchField Value="@search" ValueChanged="value => search = value" Placeholder="@T[InfernoWebLocalizableStrings.Admin.SearchPlaceholder]" />
    </div>

    @if (!VisibleTasks.Any())
    {
        <EmptyState Icon="search" Title="@T[InfernoWebLocalizableStrings.Admin.NoMatchesTitle]" Description="@T[InfernoWebLocalizableStrings.Admin.NoMatchesDescription]" />
    }
    else
    {
        <Table>
            <thead>
                <tr>
                    <th>@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Name]</th>
                    <th>@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Seconds]</th>
                    <th>@T[InfernoWebLocalizableStrings.General.Status]</th>
                    <th>@T[InfernoWebLocalizableStrings.ScheduledTasks.LastRun]</th>
                    <th>@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.LastSuccessUtc]</th>
                    <th class="nf-cell-actions"><span class="nf-sr-only">@T[InfernoWebLocalizableStrings.General.Actions]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in VisibleTasks)
                {
                    <tr @key="task.Id">
                        <td>
                            @if (canWrite)
                            {
                                <button type="button" class="nf-link-button nf-row-title" @onclick="() => Edit(task)">@task.Name</button>
                            }
                            else
                            {
                                <span class="nf-row-title">@task.Name</span>
                            }
                        </td>
                        <td class="nf-cell-nowrap">@T[InfernoWebLocalizableStrings.ScheduledTasks.EveryFormat, FormatInterval(task.Seconds)]</td>
                        <td>
                            @if (running.Contains(task.Id))
                            {
                                <span class="nf-badge nf-badge-info">@T[InfernoWebLocalizableStrings.General.PleaseWait]</span>
                            }
                            else if (task.Enabled)
                            {
                                <span class="nf-badge nf-badge-success">@T[InfernoWebLocalizableStrings.General.Enabled]</span>
                            }
                            else
                            {
                                <span class="nf-badge nf-badge-muted">@T[InfernoWebLocalizableStrings.Admin.Off]</span>
                            }
                            @if (LastRunFailed(task))
                            {
                                <span class="nf-badge nf-badge-danger">@T[InfernoWebLocalizableStrings.General.Error]</span>
                            }
                        </td>
                        <td class="nf-muted nf-cell-nowrap">@FormatTime(task.LastStartUtc)</td>
                        <td class="nf-muted nf-cell-nowrap">@FormatTime(task.LastSuccessUtc)</td>
                        <td class="nf-cell-actions">
                            @if (canWrite)
                            {
                                <div class="nf-row-actions">
                                    <button type="button" class="nf-button nf-button-sm" disabled="@running.Contains(task.Id)" @onclick="() => RunNowAsync(task)">
                                        <Icon Name="play" Size="14" /> @T[InfernoWebLocalizableStrings.ScheduledTasks.RunNow]
                                    </button>
                                    <button type="button" class="nf-icon-button" title="@T[InfernoWebLocalizableStrings.General.Edit]" @onclick="() => Edit(task)">
                                        <Icon Name="edit" Size="16" />
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </Table>
    }
}

<Drawer Open="editing is not null" Scrim="true" Width="min(440px, 100vw)" OnClose="Close" Title="@editing?.Name">
    <ChildContent>
        @if (editing is not null)
        {
            <EditForm id="task-form" Model="form" OnValidSubmit="SaveAsync">
                <Field Label="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Seconds]" For="task-seconds">
                    <InputNumber id="task-seconds" class="nf-input" min="1" @bind-Value="form.Seconds" />
                    <span class="nf-hint">@T[InfernoWebLocalizableStrings.ScheduledTasks.SecondsHint] @T[InfernoWebLocalizableStrings.ScheduledTasks.EveryFormat, FormatInterval(form.Seconds)]</span>
                    <ErrorText Errors="errors" Key="Seconds" />
                </Field>
                <Switch @bind-Value="form.Enabled" Label="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Enabled]" />
                <Switch @bind-Value="form.StopOnError" Label="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.StopOnError]" Description="@T[InfernoWebLocalizableStrings.ScheduledTasks.StopOnErrorHint]" />
            </EditForm>

            <ul class="nf-meta-list">
                <li><span>@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.LastStartUtc]</span><span>@FormatTime(editing.LastStartUtc)</span></li>
                <li><span>@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.LastEndUtc]</span><span>@FormatTime(editing.LastEndUtc)</span></li>
                <li><span>@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.LastSuccessUtc]</span><span>@FormatTime(editing.LastSuccessUtc)</span></li>
            </ul>
        }
    </ChildContent>
    <Footer>
        @if (editing is not null)
        {
            <button type="button" class="nf-button nf-drawer-foot-start" disabled="@running.Contains(editing.Id)" @onclick="() => RunNowAsync(editing)">
                <Icon Name="play" Size="16" /> @T[InfernoWebLocalizableStrings.ScheduledTasks.RunNow]
            </button>
        }
        <button type="button" class="nf-button" @onclick="Close">@T[InfernoWebLocalizableStrings.General.Cancel]</button>
        <button type="submit" form="task-form" class="nf-button nf-button-primary">
            <Icon Name="save" Size="16" /> @T[InfernoWebLocalizableStrings.General.Save]
        </button>
    </Footer>
</Drawer>

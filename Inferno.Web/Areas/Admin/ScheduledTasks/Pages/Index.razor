@page "/admin/scheduled-tasks/index"
@inherits RadzenDataPage<ScheduledTask, int>

<h1>@T[InfernoWebLocalizableStrings.ScheduledTasks.Title]</h1>

<div class="row" hidden="@(ShowEditMode == true)">
    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="ScheduledTask"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="20"
                        ColumnWidth="160px">
            <Columns>
                <RadzenDataGridColumn TItem="ScheduledTask" Property="Name" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Name]" />
                <RadzenDataGridColumn TItem="ScheduledTask" Property="Seconds" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Seconds]" Width="120px" />
                <RadzenDataGridColumn TItem="ScheduledTask" Property="Enabled" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Enabled]" Width="100px" />
                <RadzenDataGridColumn TItem="ScheduledTask" Property="StopOnError" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.StopOnError]" Width="120px" />
                <RadzenDataGridColumn TItem="ScheduledTask" Property="LastStartUtc" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.LastStartUtc]" FormatString="{0:yyyy-MM-dd HH:mm:ss}" />
                <RadzenDataGridColumn TItem="ScheduledTask" Property="LastEndUtc" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.LastEndUtc]" FormatString="{0:yyyy-MM-dd HH:mm:ss}" />
                <RadzenDataGridColumn TItem="ScheduledTask" Property="LastSuccessUtc" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.LastSuccessUtc]" FormatString="{0:yyyy-MM-dd HH:mm:ss}" />
                <RadzenDataGridColumn TItem="ScheduledTask" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="160px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(args => EditAsync(record.Id))" @onclick:stopPropagation="true" />
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="play_arrow" Size="ButtonSize.Medium" Title="@T[InfernoWebLocalizableStrings.ScheduledTasks.RunNow]" Click="@(args => RunNowAsync(record.Id))" @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="form-section" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">@T[InfernoWebLocalizableStrings.General.Details]</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Name">@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Name]</label>
                                <div class="col-md-9">
                                    <p class="form-control-plaintext">@Model.Name</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Seconds">@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Seconds]</label>
                                <div class="col-md-9">
                                    <RadzenNumeric TValue="int" @bind-Value="Model.Seconds" Min="1" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Enabled">@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.Enabled]</label>
                                <div class="col-md-9">
                                    <RadzenCheckBox TValue="bool" @bind-Value="Model.Enabled" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="StopOnError">@T[InfernoWebLocalizableStrings.ScheduledTasks.Model.StopOnError]</label>
                                <div class="col-md-9">
                                    <RadzenCheckBox TValue="bool" @bind-Value="Model.StopOnError" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

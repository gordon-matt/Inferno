@page "/admin"
@page "/admin/index"

@attribute [Authorize(Policy = StandardPolicies.AdminAccess)]

<PageTitle>@T[InfernoWebLocalizableStrings.Dashboard.Title]</PageTitle>

<PageHeader Title="@T[InfernoWebLocalizableStrings.Dashboard.Title]" Icon="home" Description="@T[InfernoWebLocalizableStrings.Dashboard.Welcome]" />

@if (visibleContent.Count > 0)
{
    <h2 class="inferno-section-title">@T[InfernoWebLocalizableStrings.Dashboard.Content]</h2>
    <div class="nf-grid">
    @foreach (var tile in visibleContent)
    {
        <a class="nf-card inferno-tile" href="@tile.Href" @key="tile.Href">
            <span class="inferno-tile-icon"><Icon Name="@tile.Icon" Size="22" /></span>
            <span class="inferno-tile-body">
                <span class="inferno-tile-title">@T[tile.Title]</span>
                <span class="inferno-tile-meta">@T[tile.Subtitle]</span>
            </span>
        </a>
    }
    </div>
}

@if (visibleAdmin.Count > 0)
{
    <h2 class="inferno-section-title">@T[InfernoWebLocalizableStrings.Dashboard.Administration]</h2>
    <div class="nf-grid">
    @foreach (var tile in visibleAdmin)
    {
        <a class="nf-card inferno-tile" href="@tile.Href" @key="tile.Href" data-enhance-nav="@(tile.FullReload ? "false" : null)">
            <span class="inferno-tile-icon"><Icon Name="@tile.Icon" Size="22" /></span>
            <span class="inferno-tile-body">
                <span class="inferno-tile-title">@T[tile.Title]</span>
                <span class="inferno-tile-meta">@T[tile.Subtitle]</span>
            </span>
        </a>
    }
    </div>
}

@if (visibleMaintenance.Count > 0)
{
    <h2 class="inferno-section-title">@T[InfernoWebLocalizableStrings.Maintenance.Title]</h2>
    <div class="nf-grid">
    @foreach (var tile in visibleMaintenance)
    {
        <a class="nf-card inferno-tile" href="@tile.Href" @key="tile.Href" target="@(tile.NewTab ? "_blank" : null)" rel="@(tile.NewTab ? "noopener noreferrer" : null)" data-enhance-nav="false">
            <span class="inferno-tile-icon"><Icon Name="@tile.Icon" Size="22" /></span>
            <span class="inferno-tile-body">
                <span class="inferno-tile-title">@T[tile.Title]</span>
                @if (!string.IsNullOrEmpty(tile.Subtitle))
                {
                    <span class="inferno-tile-meta">@T[tile.Subtitle]</span>
                }
            </span>
        </a>
    }
    </div>
}

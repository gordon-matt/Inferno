@page "/admin/localization/index"
@inherits RadzenDataPage<Language, Guid>

<h1>Localization</h1>

<div class="row" hidden="@(ShowEditMode == true)">
    <div class="col-12 mb-3">
        <RadzenButton Click="Create">
            <i class="fas fa-plus-circle" aria-hidden="true"></i>
            @T[InfernoWebLocalizableStrings.General.Create]
        </RadzenButton>
        <RadzenButton Text="Clear" Click="@(args => ClearAsync())">
            @T[InfernoWebLocalizableStrings.General.Clear]
        </RadzenButton>
        <RadzenButton Text="Clear" Click="@(args => ImportLanguagePack())">
            @T[InfernoWebLocalizableStrings.General.Import]
        </RadzenButton>
    </div>

    <div class="col-12">
        <RadzenDataGrid @ref="DataGrid"
                        TItem="Language"
                        IsLoading="@IsLoading"
                        LoadData="@LoadGridAsync"
                        Data="Records"
                        Count="@RecordCount"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Advanced"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowPaging="true"
                        PageSize="10"
                        ColumnWidth="200px">
            <Columns>
                <RadzenDataGridColumn TItem="Language" Property="Name" Title="@T[InfernoWebLocalizableStrings.General.Name]" />
                <RadzenDataGridColumn TItem="Language" Property="CultureCode" Title="@T[InfernoWebLocalizableStrings.Localization.LanguageModel.CultureCode]" />
                <RadzenDataGridColumn TItem="Language" Property="IsEnabled" Title="@T[InfernoWebLocalizableStrings.General.Enabled]">
                    <Template Context="record">
                        @if (record.IsEnabled)
                        {
                            <i class="fas fa-check text-success" aria-hidden="true"></i>
                        }
                        else
                        {
                            <i class="fas fa-times text-danger" aria-hidden="true"></i>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Language" Property="SortOrder" Title="@T[InfernoWebLocalizableStrings.Localization.LanguageModel.SortOrder]" />
                <RadzenDataGridColumn TItem="Language" Context="record" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="50px">
                    <Template Context="record">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="edit" Size="ButtonSize.Medium" Click="@(args => EditAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Size="ButtonSize.Medium" Click="@(args => DeleteAsync(record.Id))" @onclick:stopPropagation="true"></RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="language" Size="ButtonSize.Medium" Click="@(args => Localize(record.CultureCode))" @onclick:stopPropagation="true"></RadzenButton>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

<div class="row" id="form-section" hidden="@(ShowEditMode == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">Details</div>
            <div class="card-body">
                <EditForm class="form-horizontal" Model="Model" OnValidSubmit="OnValidSumbitAsync">
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="CultureCode">@T[InfernoWebLocalizableStrings.Localization.LanguageModel.CultureCode]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.CultureCode" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Name">@T[InfernoWebLocalizableStrings.General.Name]</label>
                                <div class="col-md-9">
                                    <RadzenTextBox @bind-Value="Model.Name" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="SortOrder">@T[InfernoWebLocalizableStrings.Localization.LanguageModel.SortOrder]</label>
                                <div class="col-md-9">
                                    <RadzenNumeric @bind-Value="Model.SortOrder" Style="width:100%" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Name"></label>
                                <div class="col-md-9">
                                    <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.IsRTL" />@T[InfernoWebLocalizableStrings.Localization.LanguageModel.IsRTL]</label></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="Name"></label>
                                <div class="col-md-9">
                                    <div class="form-check"><label class="form-check-label"><input class="form-check-input me-2" type="checkbox" @bind="Model.IsEnabled" />@T[InfernoWebLocalizableStrings.General.Enabled]</label></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary">
                                    <i class="fas fa-save" aria-hidden="true"></i> @T[InfernoWebLocalizableStrings.General.Save]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<div class="row" id="upload-section" hidden="@(ShowUploadSection == false)">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white bg-primary">Details</div>
            <div class="card-body">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-12">
                            <div class="row mb-3">
                                <label class="col-form-label col-md-3" for="CultureCode">@T[InfernoWebLocalizableStrings.General.Upload]</label>
                                <div class="col-md-9">
                                    <InputFile class="form-control" OnChange="OnLanguagePackSelected" accept=".json,application/json" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3 float-end">
                                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Click="Cancel">
                                    @T[InfernoWebLocalizableStrings.General.Cancel]
                                </RadzenButton>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
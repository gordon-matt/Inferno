@using Inferno.Web.Messaging.Configuration
@inherits Inferno.Web.Components.SettingsEditor<SmtpSettings>

<TabSet KeepPanelsMounted="true" AriaLabel="@Data?.Name">
    <Tab Id="server" Title="@T[InfernoWebLocalizableStrings.Settings.Smtp.Tabs.Server]">
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.DisplayName]" For="smtp-display-name">
            <input id="smtp-display-name" class="nf-input" @bind="Model.DisplayName" />
        </Field>
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.Host]" For="smtp-host">
            <input id="smtp-host" class="nf-input" @bind="Model.Host" placeholder="smtp.example.com" />
        </Field>
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.Port]" For="smtp-port">
            <input id="smtp-port" class="nf-input" type="number" min="1" max="65535" @bind="Model.Port" />
        </Field>
        <Switch @bind-Value="Model.EnableSsl" Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.EnableSsl]" />
    </Tab>
    <Tab Id="credentials" Title="@T[InfernoWebLocalizableStrings.Settings.Smtp.Tabs.Credentials]">
        <Switch @bind-Value="Model.UseDefaultCredentials" Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.UseDefaultCredentials]" />
        @if (!Model.UseDefaultCredentials)
        {
            <Field Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.Username]" For="smtp-username">
                <input id="smtp-username" class="nf-input" autocomplete="off" @bind="Model.Username" />
            </Field>
            <Field Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.Password]" For="smtp-password">
                <input id="smtp-password" class="nf-input" type="password" autocomplete="new-password" @bind="Model.Password" />
            </Field>
        }
    </Tab>
    <Tab Id="queue" Title="@T[InfernoWebLocalizableStrings.Settings.Smtp.Tabs.Queue]">
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.MaxTries]" For="smtp-max-tries">
            <input id="smtp-max-tries" class="nf-input" type="number" min="1" @bind="Model.MaxTries" />
        </Field>
        <Field Label="@T[InfernoWebLocalizableStrings.Settings.Smtp.MessagesPerBatch]" For="smtp-batch">
            <input id="smtp-batch" class="nf-input" type="number" min="1" @bind="Model.MessagesPerBatch" />
        </Field>
    </Tab>
</TabSet>

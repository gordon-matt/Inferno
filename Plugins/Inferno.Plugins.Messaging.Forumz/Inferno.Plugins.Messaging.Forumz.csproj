<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Title>Forums</Title>
		<Description>A Blazor forum mounted at /forums. Groups, topics, posts, subscriptions and direct messages.</Description>
		<Authors>Inferno</Authors>
		<IsPluginzPlugin>true</IsPluginzPlugin>
		<PluginzSystemName>Inferno.Plugins.Messaging.Forumz</PluginzSystemName>
		<PluginzGroup>Messaging</PluginzGroup>
		<!-- Class libraries do not copy NuGet assemblies. The filter below keeps EasyChatz.Data.Sql beside the plugin. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dependo.Autofac">
			<PrivateAssets>all</PrivateAssets>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Extenso.Data.Entity">
			<PrivateAssets>all</PrivateAssets>
			<ExcludeAssets>runtime</ExcludeAssets>
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Forumz" />
		<PackageReference Include="Forumz.Data.Sql" />
		<PackageReference Include="Heroicsoft.NetForge.Components">
			<PrivateAssets>all</PrivateAssets>
			<ExcludeAssets>runtime</ExcludeAssets>
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Pluginz.Core">
			<PrivateAssets>all</PrivateAssets>
			<ExcludeAssets>runtime</ExcludeAssets>
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Pluginz.Web">
			<PrivateAssets>all</PrivateAssets>
			<ExcludeAssets>runtime</ExcludeAssets>
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Inferno.Identity\Inferno.Identity.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\..\Inferno.Web\Inferno.Web.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\..\Inferno.Web.ContentManagement\Inferno.Web.ContentManagement.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<Target Name="DropHostAssemblies" BeforeTargets="_CopyFilesMarkedCopyLocal">
		<ItemGroup>
			<!-- Forumz is not part of the host, so its assemblies stay beside the plugin. -->
			<!-- Forumz and EasyChatz are not part of the host, so their assemblies stay beside the plugin. -->
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' != '$(AssemblyName)' AND !$([System.String]::Copy('%(Filename)').StartsWith('Forumz')) AND !$([System.String]::Copy('%(Filename)').StartsWith('EasyChatz'))" />
		</ItemGroup>
	</Target>

	<Target Name="CopyToInfernoCms" AfterTargets="Build">
		<PropertyGroup>
			<_PluginDest>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\InfernoCMS\Plugins\$(PluginzSystemName)'))</_PluginDest>
		</PropertyGroup>
		<ItemGroup>
			<_PluginFile Include="$(OutputPath)**\*.*" />
			<_StalePluginAssembly Include="$(_PluginDest)\*.dll" Exclude="$(_PluginDest)\$(AssemblyName).dll" />
			<_StalePluginAssembly Include="$(_PluginDest)\*.pdb" Exclude="$(_PluginDest)\$(AssemblyName).pdb" />
		</ItemGroup>
		<Delete Files="@(_StalePluginAssembly)" />
		<Copy SourceFiles="@(_PluginFile)" DestinationFiles="@(_PluginFile->'$(_PluginDest)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

</Project>
